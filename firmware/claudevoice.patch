diff --git a/main/cv_discovery.cc b/main/cv_discovery.cc
new file mode 100644
index 0000000..ba24d88
--- /dev/null
+++ b/main/cv_discovery.cc
@@ -0,0 +1,119 @@
+#include "cv_discovery.h"
+
+#include <cJSON.h>
+#include <esp_log.h>
+#include <esp_mac.h>
+#include <esp_timer.h>
+#include <lwip/sockets.h>
+
+#include <cstring>
+
+#include "settings.h"
+
+#define TAG "CvDiscovery"
+
+namespace cv_discovery {
+
+static std::string MacString() {
+    uint8_t mac[6] = {};
+    esp_read_mac(mac, ESP_MAC_WIFI_STA);
+    char s[18];
+    snprintf(s, sizeof(s), "%02x:%02x:%02x:%02x:%02x:%02x", mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
+    return s;
+}
+
+static std::string CurrentUrl() {
+    Settings settings("wifi", false);
+    std::string url = settings.GetString("ota_url");
+    return url.empty() ? std::string(CONFIG_OTA_URL) : url;
+}
+
+std::string Discover(int timeout_ms) {
+    int sock = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+    if (sock < 0) {
+        ESP_LOGE(TAG, "socket() failed");
+        return "";
+    }
+    int yes = 1;
+    setsockopt(sock, SOL_SOCKET, SO_BROADCAST, &yes, sizeof(yes));
+    timeval tv = {0, 200 * 1000};
+    setsockopt(sock, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+
+    std::string paired;
+    {
+        Settings settings("wifi", false);
+        paired = settings.GetString("cv_srv_id");
+    }
+    char msg[160];
+    snprintf(msg, sizeof(msg), "{\"cv\":\"discover\",\"device\":\"%s\",\"paired\":\"%s\"}",
+             MacString().c_str(), paired.c_str());
+
+    sockaddr_in to = {};
+    to.sin_family = AF_INET;
+    to.sin_port = htons(kPort);
+    to.sin_addr.s_addr = htonl(INADDR_BROADCAST);
+
+    std::string best_url, best_id, any_url, any_id;
+    int64_t end = esp_timer_get_time() + (int64_t)timeout_ms * 1000;
+    int64_t next_send = 0;
+    while (esp_timer_get_time() < end && best_url.empty()) {
+        if (esp_timer_get_time() >= next_send) {   // re-broadcast: UDP may be lost
+            sendto(sock, msg, strlen(msg), 0, (sockaddr*)&to, sizeof(to));
+            next_send = esp_timer_get_time() + 700 * 1000;
+        }
+        char buf[512];
+        sockaddr_in from = {};
+        socklen_t flen = sizeof(from);
+        int n = recvfrom(sock, buf, sizeof(buf) - 1, 0, (sockaddr*)&from, &flen);
+        if (n <= 0) continue;
+        buf[n] = 0;
+        cJSON* root = cJSON_Parse(buf);
+        if (!root) continue;
+        auto* cv = cJSON_GetObjectItem(root, "cv");
+        auto* id = cJSON_GetObjectItem(root, "id");
+        auto* ota = cJSON_GetObjectItem(root, "ota");
+        if (cJSON_IsString(cv) && strcmp(cv->valuestring, "server") == 0 && cJSON_IsString(id) &&
+            cJSON_IsString(ota) && strncmp(ota->valuestring, "http", 4) == 0) {
+            ESP_LOGI(TAG, "server %s answered: %s", id->valuestring, ota->valuestring);
+            if (!paired.empty() && paired == id->valuestring) {
+                best_url = ota->valuestring;
+                best_id = id->valuestring;
+            } else if (any_url.empty()) {
+                any_url = ota->valuestring;
+                any_id = id->valuestring;
+            }
+        }
+        cJSON_Delete(root);
+    }
+    close(sock);
+
+    // An unpaired device pairs with the first server; a paired one switches only if its server is gone
+    // and another one answered (e.g. the server was reinstalled and got a new id).
+    if (best_url.empty() && !any_url.empty()) {
+        best_url = any_url;
+        best_id = any_id;
+        ESP_LOGW(TAG, "%s server %s", paired.empty() ? "pairing with" : "paired server silent, switching to",
+                 best_id.c_str());
+    }
+    if (best_url.empty()) {
+        ESP_LOGW(TAG, "no ClaudeVoice server answered on UDP %d", kPort);
+        return "";
+    }
+    Settings settings("wifi", true);
+    settings.SetString("ota_url", best_url);
+    settings.SetString("cv_srv_id", best_id);
+    return best_url;
+}
+
+bool RediscoverChanged(int timeout_ms) {
+    std::string before = CurrentUrl();
+    std::string found = Discover(timeout_ms);
+    return !found.empty() && found != before;
+}
+
+void Unpair() {
+    Settings settings("wifi", true);
+    settings.SetString("cv_srv_id", "");
+}
+
+}  // namespace cv_discovery
diff --git a/main/cv_discovery.h b/main/cv_discovery.h
new file mode 100644
index 0000000..ae828ff
--- /dev/null
+++ b/main/cv_discovery.h
@@ -0,0 +1,24 @@
+// Finds the ClaudeVoice server on the local network, so the device keeps working when the PC
+// (or the device) gets a different IP address.
+//
+// The device broadcasts {"cv":"discover",...} to UDP port 8766; every ClaudeVoice server on the
+// LAN answers with its id and its OTA URL. The device remembers the server it paired with
+// (NVS "wifi"/"cv_srv_id") and prefers it; an unpaired device takes the first server that answers.
+#pragma once
+#include <string>
+
+namespace cv_discovery {
+
+constexpr int kPort = 8766;
+
+// Broadcast and wait up to timeout_ms for answers. On success stores the OTA URL in NVS
+// ("wifi"/"ota_url", read by Ota::GetCheckVersionUrl) and returns it; returns "" if nobody answered.
+std::string Discover(int timeout_ms = 2500);
+
+// True when Discover() found a server whose URL differs from the one in use (caller should retry/reconnect).
+bool RediscoverChanged(int timeout_ms = 2500);
+
+// Forget the paired server (next discovery pairs with whoever answers first).
+void Unpair();
+
+}  // namespace cv_discovery
diff --git a/main/display/cv_audio_level.h b/main/display/cv_audio_level.h
new file mode 100644
index 0000000..8d07c81
--- /dev/null
+++ b/main/display/cv_audio_level.h
@@ -0,0 +1,28 @@
+// Voice level taps for the eye animation (written by AudioService, read by the display).
+#pragma once
+
+#include <atomic>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+
+namespace cv {
+
+inline std::atomic<float> g_mic_level{0.0f};
+inline std::atomic<float> g_spk_level{0.0f};
+inline std::atomic<int64_t> g_mic_time_us{0};   // esp_timer_get_time() of last update
+inline std::atomic<int64_t> g_spk_time_us{0};
+
+// RMS of int16 PCM mapped to 0..1 over roughly -50..-12 dBFS.
+inline float PcmLevel(const int16_t* data, size_t n) {
+    if (n == 0) return 0.0f;
+    uint64_t acc = 0;
+    for (size_t i = 0; i < n; i += 2) acc += (int32_t)data[i] * data[i];
+    float rms = sqrtf((float)acc / (float)((n + 1) / 2)) / 32768.0f;
+    if (rms < 1e-6f) return 0.0f;
+    float db = 20.0f * log10f(rms);
+    float v = (db + 50.0f) / 38.0f;
+    return v < 0 ? 0 : (v > 1 ? 1 : v);
+}
+
+}  // namespace cv
