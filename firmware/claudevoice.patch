+#include <algorithm>
+
+class CvGenericBoard : public WifiBoard {
+private:
+    Button boot_button_;
+    Button volume_up_button_;
+    Button volume_down_button_;
+    Display* display_ = nullptr;
+    CvEyesDisplay* eyes_ = nullptr;
+    AudioCodec* codec_ = nullptr;
+    PowerSaveTimer* power_save_timer_ = nullptr;
+
+    void InitializePower() {
+        const auto& hw = cv::Hw();
+        if (hw.power_latch >= 0) {   // boards that cut their own battery power unless a pin is held high
+            gpio_config_t io = {};
+            io.pin_bit_mask = 1ULL << hw.power_latch;
+            io.mode = GPIO_MODE_OUTPUT;
+            gpio_config(&io);
+            gpio_set_level((gpio_num_t)hw.power_latch, 1);
+            gpio_hold_en((gpio_num_t)hw.power_latch);
+        }
+        power_save_timer_ = new PowerSaveTimer(-1, 60, 300);
+        power_save_timer_->OnEnterSleepMode([this]() {
+            GetDisplay()->SetPowerSaveMode(true);
+            if (GetBacklight()) GetBacklight()->SetBrightness(1);
+        });
+        power_save_timer_->OnExitSleepMode([this]() {
+            GetDisplay()->SetPowerSaveMode(false);
+            if (GetBacklight()) GetBacklight()->RestoreBrightness();
+        });
+        power_save_timer_->SetEnabled(true);
+    }
+
+    void ChangeVolume(int delta) {
+        power_save_timer_->WakeUp();
+        auto codec = GetAudioCodec();
+        int v = std::clamp(codec->output_volume() + delta, 0, 100);
+        codec->SetOutputVolume(v);
+        GetDisplay()->ShowNotification(Lang::Strings::VOLUME + std::to_string(v / 10));
+    }
+
+    void InitializeButtons() {
+        boot_button_.OnClick([this]() {
+            power_save_timer_->WakeUp();
+            auto& app = Application::GetInstance();
+            if (app.GetDeviceState() == kDeviceStateStarting) {
+                EnterWifiConfigMode();
+                return;
+            }
+            app.ToggleChatState();
+        });
+        boot_button_.OnLongPress([this]() {
+            power_save_timer_->WakeUp();
+            Application::GetInstance().SetDeviceState(kDeviceStateWifiConfiguring);
+            EnterWifiConfigMode();
+        });
+        volume_up_button_.OnClick([this]() { ChangeVolume(10); });
+        volume_up_button_.OnLongPress([this]() {
+            GetAudioCodec()->SetOutputVolume(100);
+            GetDisplay()->ShowNotification(Lang::Strings::MAX_VOLUME);
+        });
+        volume_down_button_.OnClick([this]() { ChangeVolume(-10); });
+        volume_down_button_.OnLongPress([this]() {
+            GetAudioCodec()->SetOutputVolume(0);
+            GetDisplay()->ShowNotification(Lang::Strings::MUTED);
+        });
+    }
+
+public:
+    CvGenericBoard()
+        : boot_button_(cv::PinOrNc(cv::Hw().btn_boot)),
+          volume_up_button_(cv::PinOrNc(cv::Hw().btn_vol_up)),
+          volume_down_button_(cv::PinOrNc(cv::Hw().btn_vol_down)) {
+        InitializePower();
+        InitializeButtons();
+        display_ = cv::CreateDisplay(cv::Hw().display, &eyes_);
+        cv::InitIo(display_, eyes_);
+        cv::RegisterEyeTools(&eyes_);
+        cv::StartBootTask(&eyes_);
+        if (GetBacklight()) GetBacklight()->RestoreBrightness();
+    }
+
+    AudioCodec* GetAudioCodec() override {
+        if (!codec_) codec_ = cv::CreateAudioCodec(cv::Hw().audio);
+        return codec_;
+    }
+
+    Display* GetDisplay() override { return display_; }
+
+    Backlight* GetBacklight() override {
+        const auto& d = cv::Hw().display;
+        if (d.bl < 0 || d.IsOled() || d.driver == "none") return nullptr;
+        static PwmBacklight backlight(cv::PinOrNc(d.bl), d.bl_invert);
+        return &backlight;
+    }
+
+    Led* GetLed() override {
+        static Led* led = cv::Hw().led >= 0 ? (Led*)new SingleLed(cv::PinOrNc(cv::Hw().led)) : nullptr;
+        return led ? led : WifiBoard::GetLed();
+    }
+
+    Camera* GetCamera() override {
+        static Camera* camera = nullptr;
+        static bool tried = false;
+        if (!tried) {
+            tried = true;
+            camera = cv::CreateCamera(cv::Hw().camera);
+        }
+        return camera;
+    }
+
+    void SetPowerSaveLevel(PowerSaveLevel level) override {
+        if (level != PowerSaveLevel::LOW_POWER) power_save_timer_->WakeUp();
+        WifiBoard::SetPowerSaveLevel(level);
+    }
+};
diff --git a/main/boards/claudevoice-common/cv_hw.cc b/main/boards/claudevoice-common/cv_hw.cc
new file mode 100644
index 0000000..9351e12
--- /dev/null
+++ b/main/boards/claudevoice-common/cv_hw.cc
@@ -0,0 +1,296 @@
+#include "cv_hw.h"
+
+#include "board.h"
+#include "config.h"
+#include "settings.h"
+#include "system_info.h"
+
+#include <cJSON.h>
+#include <driver/gpio.h>
+#include <esp_log.h>
+#include <esp_system.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/task.h>
+
+#include <memory>
+#include <mutex>
+
+#define TAG "CvHw"
+
+#ifndef CV_DEFAULT_PROFILE
+#define CV_DEFAULT_PROFILE "{}"
+#endif
+#ifndef CV_SAFE_MODE_GPIO
+#define CV_SAFE_MODE_GPIO GPIO_NUM_NC
+#endif
+
+namespace cv {
+namespace {
+
+HwConfig g_hw;
+bool g_loaded = false;
+std::mutex g_mu;
+
+int Int(cJSON* o, const char* k, int def) {
+    auto* v = cJSON_GetObjectItem(o, k);
+    return cJSON_IsNumber(v) ? v->valueint : def;
+}
+bool Bool(cJSON* o, const char* k, bool def) {
+    auto* v = cJSON_GetObjectItem(o, k);
+    return cJSON_IsBool(v) ? cJSON_IsTrue(v) : def;
+}
+std::string Str(cJSON* o, const char* k, const std::string& def) {
+    auto* v = cJSON_GetObjectItem(o, k);
+    return cJSON_IsString(v) ? std::string(v->valuestring) : def;
+}
+
+// Applies the JSON on top of `hw` (missing keys keep their current values).
+bool ParseInto(const std::string& json, HwConfig& hw) {
+    cJSON* root = cJSON_Parse(json.c_str());
+    if (!root) return false;
+    if (auto* d = cJSON_GetObjectItem(root, "display"); cJSON_IsObject(d)) {
+        auto& x = hw.display;
+        x.driver = Str(d, "driver", x.driver);
+        x.width = Int(d, "width", x.width);
+        x.height = Int(d, "height", x.height);
+        x.offset_x = Int(d, "offset_x", x.offset_x);
+        x.offset_y = Int(d, "offset_y", x.offset_y);
+        x.mirror_x = Bool(d, "mirror_x", x.mirror_x);
+        x.mirror_y = Bool(d, "mirror_y", x.mirror_y);
+        x.swap_xy = Bool(d, "swap_xy", x.swap_xy);
+        x.invert = Bool(d, "invert", x.invert);
+        x.bgr = Str(d, "rgb_order", x.bgr ? "bgr" : "rgb") == "bgr";
+        x.bl_invert = Bool(d, "bl_invert", x.bl_invert);
+        x.spi_mode = Int(d, "spi_mode", x.spi_mode);
+        x.pclk_mhz = Int(d, "pclk_mhz", x.pclk_mhz);
+        x.i2c_addr = Int(d, "i2c_addr", x.i2c_addr);
+        if (auto* p = cJSON_GetObjectItem(d, "pins"); cJSON_IsObject(p)) {
+            x.mosi = Int(p, "mosi", x.mosi); x.sclk = Int(p, "sclk", x.sclk); x.cs = Int(p, "cs", x.cs);
+            x.dc = Int(p, "dc", x.dc); x.rst = Int(p, "rst", x.rst); x.bl = Int(p, "bl", x.bl);
+            x.sda = Int(p, "sda", x.sda); x.scl = Int(p, "scl", x.scl);
+        }
+    }
+    if (auto* a = cJSON_GetObjectItem(root, "audio"); cJSON_IsObject(a)) {
+        auto& x = hw.audio;
+        x.codec = Str(a, "codec", x.codec);
+        x.in_rate = Int(a, "in_rate", x.in_rate); x.out_rate = Int(a, "out_rate", x.out_rate);
+        x.mic_ws = Int(a, "mic_ws", x.mic_ws); x.mic_sck = Int(a, "mic_sck", x.mic_sck);
+        x.mic_din = Int(a, "mic_din", x.mic_din); x.spk_dout = Int(a, "spk_dout", x.spk_dout);
+        x.spk_bclk = Int(a, "spk_bclk", x.spk_bclk); x.spk_lrck = Int(a, "spk_lrck", x.spk_lrck);
+        x.mclk = Int(a, "mclk", x.mclk); x.bclk = Int(a, "bclk", x.bclk); x.ws = Int(a, "ws", x.ws);
+        x.dout = Int(a, "dout", x.dout); x.din = Int(a, "din", x.din); x.pa = Int(a, "pa", x.pa);
+        x.i2c_sda = Int(a, "i2c_sda", x.i2c_sda); x.i2c_scl = Int(a, "i2c_scl", x.i2c_scl);
+        x.es8311_addr = Int(a, "es8311_addr", x.es8311_addr); x.es7210_addr = Int(a, "es7210_addr", x.es7210_addr);
+        x.pa_inverted = Bool(a, "pa_inverted", x.pa_inverted); x.use_mclk = Bool(a, "use_mclk", x.use_mclk);
+    }
+    if (auto* b = cJSON_GetObjectItem(root, "buttons"); cJSON_IsObject(b)) {
+        hw.btn_boot = Int(b, "boot", hw.btn_boot);
+        hw.btn_vol_up = Int(b, "volume_up", hw.btn_vol_up);
+        hw.btn_vol_down = Int(b, "volume_down", hw.btn_vol_down);
+    }
+    if (auto* p = cJSON_GetObjectItem(root, "power"); cJSON_IsObject(p)) {
+        hw.power_latch = Int(p, "latch", hw.power_latch);
+        hw.charge_detect = Int(p, "charge_detect", hw.charge_detect);
+        hw.led = Int(p, "led", hw.led);
+    }
+    if (auto* arr = cJSON_GetObjectItem(root, "inputs"); cJSON_IsArray(arr)) {
+        hw.inputs.clear();
+        cJSON* it;
+        cJSON_ArrayForEach(it, arr) {
+            HwInput in;
+            in.pin = Int(it, "pin", -1);
+            in.touch = Str(it, "type", "touch") == "touch";
+            in.name = Str(it, "name", "input");
+            in.sensitivity = Int(it, "sensitivity", 4);
+            in.tap = Str(it, "tap", "none");
+            in.dbl = Str(it, "double", "none");
+            in.hold = Str(it, "hold", "none");
+            if (in.pin >= 0 && hw.inputs.size() < 8) hw.inputs.push_back(in);
+        }
+    }
+    if (auto* arr = cJSON_GetObjectItem(root, "outputs"); cJSON_IsArray(arr)) {
+        hw.outputs.clear();
+        cJSON* it;
+        cJSON_ArrayForEach(it, arr) {
+            HwOutput o{Int(it, "pin", -1), Str(it, "type", "led"), Str(it, "name", "output"),
+                       Bool(it, "active_low", false)};
+            if (o.pin >= 0) hw.outputs.push_back(o);
+        }
+    }
+    if (auto* c = cJSON_GetObjectItem(root, "camera"); cJSON_IsObject(c)) {
+        hw.camera.type = Str(c, "type", hw.camera.type);
+        if (auto* p = cJSON_GetObjectItem(c, "pins"); cJSON_IsObject(p)) {
+            static const char* kD[] = {"d0", "d1", "d2", "d3", "d4", "d5", "d6", "d7"};
+            for (int i = 0; i < 8; i++) hw.camera.d[i] = Int(p, kD[i], hw.camera.d[i]);
+            hw.camera.xclk = Int(p, "xclk", hw.camera.xclk); hw.camera.pclk = Int(p, "pclk", hw.camera.pclk);
+            hw.camera.vsync = Int(p, "vsync", hw.camera.vsync); hw.camera.href = Int(p, "href", hw.camera.href);
+            hw.camera.sda = Int(p, "sda", hw.camera.sda); hw.camera.scl = Int(p, "scl", hw.camera.scl);
+            hw.camera.pwdn = Int(p, "pwdn", hw.camera.pwdn); hw.camera.reset = Int(p, "reset", hw.camera.reset);
+        }
+    }
+    cJSON_Delete(root);
+    return true;
+}
+
+HwConfig Defaults() {
+    HwConfig hw;
+    if (!ParseInto(CV_DEFAULT_PROFILE, hw)) ESP_LOGE(TAG, "CV_DEFAULT_PROFILE in config.h is not valid JSON");
+    hw.from_defaults = true;
+    return hw;
+}
+
+bool Parse(const std::string& json, HwConfig& hw) {
+    hw = Defaults();
+    if (!ParseInto(json, hw)) return false;
+    hw.from_defaults = false;
+    return true;
+}
+
+// Everything except input actions needs a restart to take effect.
+std::string RebootKey(const HwConfig& h) {
+    char buf[640];
+    const auto& d = h.display;
+    const auto& a = h.audio;
+    snprintf(buf, sizeof(buf),
+             "%s|%d|%d|%d|%d|%d%d%d%d%d%d|%d|%d|%d|%d,%d,%d,%d,%d,%d,%d,%d|%s|%d|%d|%d,%d,%d,%d,%d,%d|%d,%d,%d,%d,%d|%d,%d,%d,%d,%d,%d%d|%d,%d,%d|%d,%d,%d|%s",
+             d.driver.c_str(), d.width, d.height, d.offset_x, d.offset_y, d.mirror_x, d.mirror_y, d.swap_xy, d.invert,
+             d.bgr, d.bl_invert, d.spi_mode, d.pclk_mhz, d.i2c_addr, d.mosi, d.sclk, d.cs, d.dc, d.rst, d.bl, d.sda,
+             d.scl, a.codec.c_str(), a.in_rate, a.out_rate, a.mic_ws, a.mic_sck, a.mic_din, a.spk_dout, a.spk_bclk,
+             a.spk_lrck, a.mclk, a.bclk, a.ws, a.dout, a.din, a.pa, a.i2c_sda, a.i2c_scl, a.es8311_addr,
+             a.es7210_addr, a.pa_inverted, a.use_mclk, h.btn_boot, h.btn_vol_up, h.btn_vol_down, h.power_latch,
+             h.charge_detect, h.led, h.camera.type.c_str());
+    std::string k = buf;
+    for (auto& i : h.inputs) k += "|i" + std::to_string(i.pin) + (i.touch ? "t" : "b") + std::to_string(i.sensitivity);
+    for (auto& o : h.outputs) k += "|o" + std::to_string(o.pin) + o.type + (o.active_low ? "L" : "H");
+    if (h.camera.type == "board") {
+        for (int v : h.camera.d) k += "," + std::to_string(v);
+        k += "," + std::to_string(h.camera.xclk) + "," + std::to_string(h.camera.pclk) + "," +
+             std::to_string(h.camera.vsync) + "," + std::to_string(h.camera.href) + "," +
+             std::to_string(h.camera.sda) + "," + std::to_string(h.camera.scl);
+    }
+    return k;
+}
+
+void RestartTask(void*) {
+    vTaskDelay(pdMS_TO_TICKS(1500));   // let the MCP reply reach the server
+    esp_restart();
+}
+
+}  // namespace
+
+const HwConfig& Hw() {
+    std::lock_guard<std::mutex> lock(g_mu);
+    if (!g_loaded) {
+        g_loaded = true;
+        g_hw = Defaults();
+        bool safe = false;
+        const int safe_pin = (int)CV_SAFE_MODE_GPIO;
+        if (safe_pin >= 0) {   // safety: this button held at power-on ignores a broken profile
+            gpio_config_t io = {};
+            io.pin_bit_mask = 1ULL << safe_pin;
+            io.mode = GPIO_MODE_INPUT;
+            io.pull_up_en = GPIO_PULLUP_ENABLE;
+            gpio_config(&io);
+            vTaskDelay(pdMS_TO_TICKS(5));
+            safe = gpio_get_level((gpio_num_t)safe_pin) == 0;
+            gpio_reset_pin((gpio_num_t)safe_pin);
+        }
+        if (safe) {
+            ESP_LOGW(TAG, "safe-mode button held at boot: using the factory hardware profile");
+        } else {
+            Settings settings("cvhw", false);
+            std::string json = settings.GetString("json");
+            if (!json.empty() && !Parse(json, g_hw)) {
+                ESP_LOGE(TAG, "stored hardware profile is invalid, using the factory profile");
+                g_hw = Defaults();
+            }
+        }
+        ESP_LOGI(TAG, "hardware: display %s %dx%d, audio %s, %d inputs, %d outputs, camera %s (%s)",
+                 g_hw.display.driver.c_str(), g_hw.display.width, g_hw.display.height, g_hw.audio.codec.c_str(),
+                 (int)g_hw.inputs.size(), (int)g_hw.outputs.size(), g_hw.camera.type.c_str(),
+                 g_hw.from_defaults ? "factory" : "profile");
+    }
+    return g_hw;
+}
+
+void HwSetInputs(const std::vector<HwInput>& inputs) {
+    std::lock_guard<std::mutex> lock(g_mu);
+    g_hw.inputs = inputs;
+}
+
+std::vector<HwInput> HwInputsSnapshot() {
+    std::lock_guard<std::mutex> lock(g_mu);
+    return g_hw.inputs;
+}
+
+bool HwPinTaken(int pin) {
+    if (pin < 0) return false;
+    const auto& h = Hw();
+    const auto& d = h.display;
+    const auto& a = h.audio;
+    const int fixed[] = {d.mosi, d.sclk, d.cs, d.dc, d.rst, d.bl, d.sda, d.scl, a.mic_ws, a.mic_sck, a.mic_din,
+                         a.spk_dout, a.spk_bclk, a.spk_lrck, a.mclk, a.bclk, a.ws, a.dout, a.din, a.pa, a.i2c_sda,
+                         a.i2c_scl, h.btn_boot, h.btn_vol_up, h.btn_vol_down, h.power_latch, h.charge_detect, h.led};
+    for (int p : fixed) if (p == pin) return true;
+    if (h.camera.type == "board") {
+        for (int p : h.camera.d) if (p == pin) return true;
+        const int cam[] = {h.camera.xclk, h.camera.pclk, h.camera.vsync, h.camera.href, h.camera.sda, h.camera.scl,
+                           h.camera.pwdn, h.camera.reset};
+        for (int p : cam) if (p == pin) return true;
+    }
+    return false;
+}
+
+std::string HwDefaultUrl() {
+    Settings settings("wifi", false);
+    std::string url = settings.GetString("ota_url");
+    if (url.empty()) url = CONFIG_OTA_URL;
+    auto p = url.find("/xiaozhi/ota");
+    return (p == std::string::npos ? url : url.substr(0, p)) + "/device/hardware.json";
+}
+
+std::string HwReload(const std::string& url_in) {
+    std::string url = url_in.empty() ? HwDefaultUrl() : url_in;
+    auto network = Board::GetInstance().GetNetwork();
+    if (!network) return "no network";
+    auto http = network->CreateHttp(0);
+    http->SetHeader("Device-Id", SystemInfo::GetMacAddress());   // the server keeps one profile per device
+    if (!http->Open("GET", url)) return "cannot open " + url;
+    if (http->GetStatusCode() == 404) {
+        http->Close();
+        return "no profile for this device on the server: keeping the stored one";
+    }
+    if (http->GetStatusCode() != 200) {
+        int code = http->GetStatusCode();
+        http->Close();
+        return "HTTP " + std::to_string(code) + " from " + url;
+    }
+    std::string body;
+    char buf[1024];
+    while (true) {
+        int n = http->Read(buf, sizeof(buf));
+        if (n <= 0) break;
+        body.append(buf, n);
+        if (body.size() > 16384) break;
+    }
+    http->Close();
+
+    HwConfig fresh;
+    if (!Parse(body, fresh)) return "invalid hardware profile";
+    const HwConfig& cur = Hw();
+    bool reboot = RebootKey(fresh) != RebootKey(cur);
+    {
+        Settings settings("cvhw", true);
+        if (settings.GetString("json") == body) return "hardware profile unchanged";
+        settings.SetString("json", body);
+    }
+    if (reboot) {
+        ESP_LOGW(TAG, "pins/display changed: restarting");
+        xTaskCreate(RestartTask, "hw_restart", 2048, nullptr, 5, nullptr);
+        return "saved; pins or display changed, the device restarts now";
+    }
+    HwSetInputs(fresh.inputs);
+    return "saved; input actions applied";
+}
+
+}  // namespace cv
diff --git a/main/boards/claudevoice-common/cv_hw.h b/main/boards/claudevoice-common/cv_hw.h
new file mode 100644
index 0000000..d46260d
--- /dev/null
+++ b/main/boards/claudevoice-common/cv_hw.h
@@ -0,0 +1,81 @@
+// Hardware profile: display, audio codec, pins, inputs (antennae/buttons) and their actions, outputs, camera.
+// Edited in the ClaudeVoice app, downloaded from <server>/device/hardware.json, kept in NVS ("cvhw"/"json").
+// The board's config.h gives the factory profile (CV_DEFAULT_PROFILE, JSON) and the safe-mode button
+// (CV_SAFE_MODE_GPIO): hold it while powering on to boot with the factory profile.
+#pragma once
+
+#include <string>
+#include <vector>
+
+namespace cv {
+
+struct HwDisplay {
+    std::string driver = "none";     // st7789 gc9a01 ili9341 st7796 ssd1306 sh1106 none
+    int width = 240, height = 240, offset_x = 0, offset_y = 0;
+    bool mirror_x = false, mirror_y = false, swap_xy = false, invert = true, bgr = false, bl_invert = false;
+    int spi_mode = 0, pclk_mhz = 40, i2c_addr = 0x3C;
+    int mosi = -1, sclk = -1, cs = -1, dc = -1, rst = -1, bl = -1, sda = -1, scl = -1;
+    bool IsOled() const { return driver == "ssd1306" || driver == "sh1106"; }
+};
+
+struct HwAudio {
+    // none | i2s_simplex (separate I2S mic + amp, e.g. INMP441 + MAX98357) | i2s_duplex (one I2S bus)
+    // | es8311 (codec over I2C+I2S) | box (ES8311 out + ES7210 mic array)
+    std::string codec = "none";
+    int in_rate = 16000, out_rate = 24000;
+    int mic_ws = -1, mic_sck = -1, mic_din = -1, spk_dout = -1, spk_bclk = -1, spk_lrck = -1;   // simplex
+    int mclk = -1, bclk = -1, ws = -1, dout = -1, din = -1;                                     // duplex / codecs
+    int pa = -1, i2c_sda = -1, i2c_scl = -1, es8311_addr = 0x30, es7210_addr = 0x80;
+    bool pa_inverted = false, use_mclk = true;
+};
+
+struct HwInput {
+    int pin = -1;
+    bool touch = true;
+    std::string name;
+    int sensitivity = 4;                  // % rise over the baseline that counts as a touch
+    std::string tap, dbl, hold;           // comma-separated actions
+};
+
+struct HwOutput {
+    int pin = -1;
+    std::string type;                     // vibration led buzzer relay
+    std::string name;
+    bool active_low = false;
+};
+
+struct HwCamera {
+    std::string type = "none";            // none board esp32cam pc
+    int d[8] = {-1, -1, -1, -1, -1, -1, -1, -1};
+    int xclk = -1, pclk = -1, vsync = -1, href = -1, sda = -1, scl = -1, pwdn = -1, reset = -1;
+};
+
+struct HwConfig {
+    HwDisplay display;
+    HwAudio audio;
+    int btn_boot = 0, btn_vol_up = -1, btn_vol_down = -1;
+    int power_latch = -1, charge_detect = -1, led = -1;
+    std::vector<HwInput> inputs;
+    std::vector<HwOutput> outputs;
+    HwCamera camera;
+    bool from_defaults = true;
+};
+
+// Loaded once at boot (before the board initialises anything).
+const HwConfig& Hw();
+
+// Download the profile; store it. Returns a human-readable result. If pins/display changed the
+// device restarts shortly after (the reply is sent first); action-only changes apply at once.
+std::string HwReload(const std::string& url);
+
+// Profile URL next to the OTA URL: http://<server>/device/hardware.json
+std::string HwDefaultUrl();
+
+// Updates input actions in RAM (used by HwReload).
+void HwSetInputs(const std::vector<HwInput>& inputs);
+std::vector<HwInput> HwInputsSnapshot();
+
+// True if the pin is used by the profile's fixed wiring (display, audio, buttons, power, camera).
+bool HwPinTaken(int pin);
+
+}  // namespace cv
