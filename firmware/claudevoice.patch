diff --git a/main/boards/claudevoice-common/cv_skins.cc b/main/boards/claudevoice-common/cv_skins.cc
new file mode 100644
index 0000000..bd2036c
--- /dev/null
+++ b/main/boards/claudevoice-common/cv_skins.cc
@@ -0,0 +1,443 @@
+// Extra skins for cv::Eyes (port of proto/skins_render.js). Everything is drawn as phosphor
+// intensity into the 120x120 layer, so each skin can be recolored by its palette.
+#include "cv_eyes.h"
+#include "cv_font.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace cv {
+
+namespace {
+constexpr float kPi = 3.14159265f;
+inline float clampf(float v, float a, float b) { return v < a ? a : (v > b ? b : v); }
+inline float sstep(float a, float b, float x) {
+    float t = clampf((x - a) / (b - a), 0, 1);
+    return t * t * (3 - 2 * t);
+}
+inline float fract(float v) { return v - floorf(v); }
+inline float fast_atan2(float y, float x) {
+    const float ax = fabsf(x), ay = fabsf(y);
+    const float mx = ax > ay ? ax : ay, mn = ax > ay ? ay : ax;
+    const float a = mn / (mx + 1e-9f), s = a * a;
+    float r = ((-0.0464964749f * s + 0.15931422f) * s - 0.327622764f) * s * a + a;
+    if (ay > ax) r = 1.57079637f - r;
+    if (x < 0) r = 3.14159274f - r;
+    return y < 0 ? -r : r;
+}
+inline float sd_round_rect(float px, float py, float hw, float hh, float r) {
+    const float qx = fabsf(px) - hw + r, qy = fabsf(py) - hh + r;
+    const float ox = qx > 0 ? qx : 0, oy = qy > 0 ? qy : 0;
+    return sqrtf(ox * ox + oy * oy) + std::min(std::max(qx, qy), 0.0f) - r;
+}
+std::u32string U(const char* s) { return Utf8ToU32(s); }
+
+// word-wrap to `cols`, keep the last `max_lines`
+int Wrap(const std::u32string& s, int cols, std::u32string* lines, int max_lines) {
+    std::u32string all[24];
+    int n = 0;
+    std::u32string cur, word;
+    auto push = [&](const std::u32string& l) {
+        if (n < 24) all[n++] = l;
+        else { for (int i = 1; i < 24; i++) all[i - 1] = all[i]; all[23] = l; }
+    };
+    auto flush = [&]() {
+        if (word.empty()) return;
+        if (!cur.empty() && cur.size() + 1 + word.size() > (size_t)cols) { push(cur); cur.clear(); }
+        while (word.size() > (size_t)cols) { push(word.substr(0, cols)); word = word.substr(cols); }
+        if (!cur.empty()) cur += U' ';
+        cur += word;
+        word.clear();
+    };
+    for (char32_t c : s) { if (c == U' ' || c == U'\n') flush(); else word += c; }
+    flush();
+    if (!cur.empty()) push(cur);
+    const int first = std::max(0, n - max_lines);
+    for (int i = first; i < n; i++) lines[i - first] = all[i];
+    return n - first;
+}
+}  // namespace
+
+#define PUT(x, y, v) do { const int _x = (int)lroundf(x), _y = (int)lroundf(y); \
+    if (_x >= 0 && _y >= 0 && _x < LW && _y < LH) { int _v = (int)(v); if (_v > 255) _v = 255; \
+    uint8_t& _p = phos_[_y * LW + _x]; if (_v > _p) _p = (uint8_t)_v; } } while (0)
+
+void Eyes::Dot(float cx, float cy, float r, float v) {
+    for (int y = (int)floorf(cy - r - 1); y <= cy + r + 1; y++) {
+        for (int x = (int)floorf(cx - r - 1); x <= cx + r + 1; x++) {
+            const float a = 1 - sstep(r - 0.6f, r + 0.6f, sqrtf((x - cx) * (x - cx) + (y - cy) * (y - cy)));
+            if (a > 0.01f) PUT(x, y, v * a);
+        }
+    }
+}
+
+void Eyes::RingPx(float cx, float cy, float r, float v) {
+    const int n = (int)ceilf(r * 6.4f);
+    for (int i = 0; i < n; i++) {
+        const float a = i / (float)n * kPi * 2;
+        PUT(cx + cosf(a) * r, cy + sinf(a) * r, v);
+    }
+}
+
+// ---------------- ORB: modern voice assistant ----------------
+void Eyes::DrawOrb() {
+    const EyeState s = state_;
+    const Emotion e = emotion_;
+    const float L = level_, t = t_;
+    const float cx = 60 + (gx_ + mx_) * 5;
+    const float cy = 50 + (gy_ + my_) * 3 + (e == Emotion::Happy ? sinf(t * 7) * 1.5f : 0) + (e == Emotion::Sad ? 4 : 0);
+    float R = 20 * (1 + 0.05f * sinf(t * 1.7f)) * (1 + 0.3f * L);
+    if (s == EyeState::Listening) R *= 1.1f;
+    if (s == EyeState::Sleep) R *= 0.55f;
+    if (s == EyeState::Thinking) R *= 0.9f;
+    if (e == Emotion::Surprised) R *= 1.15f;
+    R *= 1 - 0.12f * blink_;
+    const float spike = e == Emotion::Angry ? 0.13f : 0.04f;
+    const float br = bright_ * (s == EyeState::Error ? 0.6f + 0.4f * Rnd(0, 1) : 1);
+    // per-frame tables: shape by angle, glow by normalized distance
+    float shape[64];
+    for (int i = 0; i < 64; i++) {
+        const float a = i / 64.0f * kPi * 2 - kPi;
+        shape[i] = 1 + spike * sinf(3 * a + t * 1.3f) + 0.035f * sinf(5 * a - t * 2.1f) + 0.09f * L * sinf(7 * a + t * 11);
+    }
+    static float glow[192];
+    static bool glow_ready = false;
+    if (!glow_ready) {
+        for (int i = 0; i < 192; i++) {
+            const float q = i / 64.0f;
+            float v = 235 * expf(-q * q * 2.4f) + 60 * expf(-q * 1.5f);
+            if (q < 0.45f) v += 40 * (1 - q / 0.45f);
+            glow[i] = v;
+        }
+        glow_ready = true;
+    }
+    const float ext = R * 2.4f;
+    const int y0 = std::max(0, (int)floorf(cy - ext)), y1 = std::min(LH - 1, (int)ceilf(cy + ext));
+    const int x0 = std::max(0, (int)floorf(cx - ext)), x1 = std::min(LW - 1, (int)ceilf(cx + ext));
+    // The orb is soft: evaluate every other pixel and fill 2x2 blocks (smooth upscale hides it).
+    const float rmin = R * (1 - spike - 0.035f - 0.09f * L), far2 = (rmin * 3) * (rmin * 3);
+    for (int y = y0 & ~1; y <= y1; y += 2) {
+        for (int x = x0 & ~1; x <= x1; x += 2) {
+            const float dx = x + 0.5f - cx, dy = y + 0.5f - cy, d2 = dx * dx + dy * dy;
+            if (d2 > far2) continue;
+            const float d = sqrtf(d2);
+            const float a = fast_atan2(dy, dx);
+            const int bin = ((int)((a + kPi) / (2 * kPi) * 64)) & 63;
+            const int qi = (int)(d / (R * shape[bin]) * 64);
+            if (qi >= 192) continue;
+            const int v = (int)(glow[qi] * br);
+            if (v <= 2) continue;
+            const uint8_t vv = (uint8_t)(v > 255 ? 255 : v);
+            for (int yy = y; yy < y + 2 && yy < LH; yy++) {
+                for (int xx = x; xx < x + 2 && xx < LW; xx++) {
+                    uint8_t& p = phos_[yy * LW + xx];
+                    if (vv > p) p = vv;
+                }
+            }
+        }
+    }
+    if (s == EyeState::Listening || s == EyeState::Speaking) {
+        for (int k = 0; k < 3; k++) {
+            const float p = fract(t * (s == EyeState::Speaking ? 0.9f : 0.55f) + k / 3.0f);
+            RingPx(cx, cy, R * (1.15f + p * 1.1f), (1 - p) * (90 + 120 * L) * br);
+        }
+    }
+    if (s == EyeState::Thinking || s == EyeState::Connecting) {
+        for (int k = 0; k < 2; k++) {
+            const float ang = t * 3.2f + k * kPi;
+            for (int j = 0; j < 22; j++) {
+                const float aa = ang - j * 0.06f, rad = R * 1.45f;
+                Dot(cx + cosf(aa) * rad, cy + sinf(aa) * rad, 1.6f, (1 - j / 22.0f) * 220 * br);
+            }
+        }
+    }
+}
+
+// ---------------- PET: soft expressive robot eyes ----------------
+void Eyes::DrawPet() {
+    const EyeState s = state_;
+    const Emotion e = emotion_;
+    const float L = level_;
+    const float gx = (gx_ + mx_) * 11, gy = (gy_ + my_) * 7;
+    for (int side = -1; side <= 1; side += 2) {
+        float w = 12.5f, h = 15, cy = 48 + gy;
+        const float cx = 60 + side * 23 + gx;
+        if (s == EyeState::Listening) { w *= 1.05f; h *= 1.08f + 0.06f * L; }
+        if (s == EyeState::Speaking) { h *= 1 - 0.1f * L; w *= 1 + 0.05f * L; }
+        if (e == Emotion::Surprised) { h *= 1.22f; w *= 0.95f; }
+        if (e == Emotion::Sleepy || s == EyeState::Sleep) { h *= 0.32f; cy += 7; }
+        if (s == EyeState::Thinking && side == 1) h *= 0.75f;
+        if (gx * side > 0) { const float k = 1 + 0.1f * fabsf(gx) / 11; w *= k; h *= k; }
+        h *= 1 - 0.93f * blink_;
+        const float r = std::min(w, h) * 0.62f;
+        const int inner = -side;
+        for (int y = (int)floorf(cy - h - 2); y <= cy + h + 2; y++) {
+            for (int x = (int)floorf(cx - w - 2); x <= cx + w + 2; x++) {
+                const float dx = x - cx, dy = y - cy;
+                float a = 1 - sstep(-0.8f, 0.8f, sd_round_rect(dx, dy, w, h, r));
+                if (a <= 0) continue;
+                const float nx = clampf(dx / w, -1, 1), inn = (nx * inner + 1) / 2;
+                float top = -h - 1, bot = h + 1;
+                if (e == Emotion::Angry) top = -h + h * 1.1f * inn;
+                if (e == Emotion::Sad) top = -h + h * 1.0f * (1 - inn);
+                if (e == Emotion::Happy) bot = h - h * 1.35f * (1 - nx * nx);
+                a *= sstep(top - 0.8f, top + 0.8f, dy) * (1 - sstep(bot - 0.8f, bot + 0.8f, dy));
+                const float shade = 0.82f + 0.18f * (1 - (dy + h) / (2 * h));
+                if (a > 0.01f) PUT(x, y, 235 * a * shade * bright_);
+            }
+        }
+    }
+    if (s == EyeState::Speaking || e == Emotion::Happy) {
+        const float mh = s == EyeState::Speaking ? 1 + L * 4 : 1.2f, mw = e == Emotion::Happy ? 8 : 6;
+        for (int y = 72; y <= 84; y++) {
+            for (int x = (int)(60 - mw - 2); x <= 60 + mw + 2; x++) {
+                const float a = 1 - sstep(-0.8f, 0.8f, sd_round_rect(x - 60 - gx * 0.3f, y - 78 - gy * 0.3f, mw, mh, std::min(mw, mh)));
+                if (a > 0.01f) PUT(x, y, 200 * a * bright_);
+            }
+        }
+    }
+}
+
+// ---------------- MINIMAL: two dots and a living line ----------------
+void Eyes::DrawMinimal() {
+    const EyeState s = state_;
+    const Emotion e = emotion_;
+    const float L = level_, t = t_;
+    const float gx = (gx_ + mx_) * 6, gy = (gy_ + my_) * 4;
+    float rad = 4.5f * (s == EyeState::Listening ? 1.15f + 0.25f * L : 1);
+    if (e == Emotion::Surprised) rad *= 1.3f;
+    for (int side = -1; side <= 1; side += 2) {
+        const float cx = 60 + side * 17 + gx, cy = 50 + gy;
+        const float ry = rad * (1 - 0.85f * blink_) * ((e == Emotion::Sleepy || s == EyeState::Sleep) ? 0.3f : 1);
+        for (int y = (int)floorf(cy - rad - 2); y <= cy + rad + 2; y++) {
+            for (int x = (int)floorf(cx - rad - 2); x <= cx + rad + 2; x++) {
+                const float qx = (x - cx) / rad, qy = (y - cy) / std::max(0.6f, ry);
+                const float a = 1 - sstep(0.85f, 1.15f, sqrtf(qx * qx + qy * qy));
+                if (a > 0.01f) PUT(x, y, 240 * a * bright_);
+            }
+        }
+    }
+    const float y0 = 70 + gy * 0.5f;
+    if (s == EyeState::Thinking || s == EyeState::Connecting) {
+        for (int k = 0; k < 3; k++) {
+            const float b = 0.5f + 0.5f * sinf(t * 6 - k * 0.9f);
+            Dot(52 + k * 8 + gx * 0.5f, y0, 1.5f + b, (120 + 120 * b) * bright_);
+        }
+        return;
+    }
+    for (float x = 42; x <= 78; x += 0.5f) {
+        const float u = (x - 60) / 18, env = cosf(u * kPi / 2);
+        float y = y0;
+        if (e == Emotion::Happy) y += 4 * (1 - u * u);
+        if (e == Emotion::Sad) y -= 3 * (1 - u * u);
+        if (s == EyeState::Speaking || s == EyeState::Listening) y += sinf(x * 0.55f - t * 14) * L * 6 * env;
+        Dot(x + gx * 0.5f, y, 1.1f, 200 * env * bright_ + 30);
+    }
+}
+
+// ---------------- HOLO: holographic AI core ----------------
+void Eyes::DrawHoloCore() {
+    const EyeState s = state_;
+    const float L = level_, t = t_, rot = iris_rot_, br = bright_;
+    const float cx = 60 + (gx_ + mx_) * 4, cy = 54 + (gy_ + my_) * 3;
+    const float grow = s == EyeState::Listening ? 2 + L * 3 : L * 2;
+    const bool radar = s == EyeState::Thinking || s == EyeState::Connecting;
+    const int y0 = std::max(0, (int)floorf(cy - 44)), y1 = std::min(LH - 1, (int)ceilf(cy + 44));
+    const int x0 = std::max(0, (int)floorf(cx - 44)), x1 = std::min(LW - 1, (int)ceilf(cx + 44));
+    for (int y = y0; y <= y1; y++) {
+        for (int x = x0; x <= x1; x++) {
+            const float dx = x - cx, dy = y - cy, d = sqrtf(dx * dx + dy * dy);
+            if (d > 43) continue;
+            float v = 0;
+            if (d < 7 + L * 2) v = 240 - d * 8;
+            if (fabsf(d - 10) < 0.7f) v = std::max(v, 150.0f);
+            const bool need_a = fabsf(d - 16) < 1 || (d > 21 && d < 25) || fabsf(d - (31 + grow)) < 1.3f ||
+                                (s == EyeState::Speaking && d > 6 && d < 19) || (radar && d > 10 && d < 39);
+            if (need_a) {
+                const float a = fast_atan2(dy, dx), an = a / (2 * kPi);
+                if (fabsf(d - 16) < 1 && fract(fract(an + rot / (2 * kPi)) * 24) < 0.6f) v = std::max(v, 140 + 80 * L);
+                if (d > 21 && d < 25) {
+                    const float p = fract(an - rot * 0.5f / (2 * kPi));
+                    if (fract(p * 36) < 0.18f) v = std::max(v, fract(p * 12) < 0.08f ? 220.0f : 110.0f);
+                }
+                if (fabsf(d - (31 + grow)) < 1.3f) {
+                    const float p = fract(an + rot * 0.8f / (2 * kPi));
+                    if (p < 0.14f || (p > 0.33f && p < 0.55f) || (p > 0.7f && p < 0.78f)) v = std::max(v, 210.0f);
+                }
+                if (s == EyeState::Speaking) {
+                    const float rw = 12.5f + L * 5 * sinf(10 * a + t * 25);
+                    if (fabsf(d - rw) < 0.8f) v = std::max(v, 230.0f);
+                }
+                if (radar && d > 10 && d < 39) {
+                    const float diff = fract(t * 1.6f - an);
+                    if (diff < 0.18f) v = std::max(v, (1 - diff / 0.18f) * 120);
+                }
+            }
+            if (fabsf(d - 39) < 0.6f) v = std::max(v, 70.0f);
+            if (v > 0) PUT(x, y, v * br);
+        }
+    }
+    for (int k = 0; k < 4; k++) {
+        const float a = k * kPi / 2 + rot * 0.2f;
+        Dot(cx + cosf(a) * 41.5f, cy + sinf(a) * 41.5f, 1.4f, 200 * br);
+    }
+}
+
+// ---------------- PIXEL: 8-bit game eyes ----------------
+void Eyes::DrawPixel() {
+    const EyeState s = state_;
+    const Emotion e = emotion_;
+    const float L = level_;
+    constexpr int B = 6;
+    auto block = [&](int bx, int by, int v) {
+        for (int y = 0; y < B - 1; y++) for (int x = 0; x < B - 1; x++) PUT(bx * B + x, by * B + y, v);
+    };
+    static const char* kOpen[5] = {"0110", "1111", "1111", "1111", "0110"};
+    static const char* kHappy[5] = {"0000", "0110", "1001", "0000", "0000"};
+    static const char* kSad[5] = {"0000", "0000", "1111", "1111", "0110"};
+    static const char* kAngryL[5] = {"1000", "1100", "1110", "1111", "0110"};
+    static const char* kAngryR[5] = {"0001", "0011", "0111", "1111", "0110"};
+    static const char* kClosed[5] = {"0000", "0000", "0000", "1111", "0000"};
+    static const char* kWide[5] = {"1111", "1111", "1111", "1111", "1111"};
+    const int px = (int)lroundf(clampf((gx_ + mx_) * 1.6f, -1, 1)), py = (int)lroundf(clampf((gy_ + my_) * 1.6f, -1, 1));
+    for (int side = -1; side <= 1; side += 2) {
+        const char* const* sh = kOpen;
+        if (e == Emotion::Happy) sh = kHappy;
+        else if (e == Emotion::Sad) sh = kSad;
+        else if (e == Emotion::Angry) sh = side < 0 ? kAngryL : kAngryR;
+        else if (e == Emotion::Surprised) sh = kWide;
+        if (blink_ > 0.5f || e == Emotion::Sleepy || s == EyeState::Sleep) sh = kClosed;
+        const bool pupil = sh != kHappy && sh != kClosed;
+        const int ox = side < 0 ? 4 : 12, oy = 5;
+        for (int r = 0; r < 5; r++) {
+            for (int c = 0; c < 4; c++) {
+                if (sh[r][c] != '1') continue;
+                const bool is_pupil = pupil && (c == 1 + px || c == 2 + px) && (r == 2 + py || r == 3 + py) && r >= 1;
+                block(ox + c, oy + r, is_pupil ? 40 : (int)(230 * bright_));
+            }
+        }
+    }
+    static const char* kTalk3[3] = {"0111110", "1000001", "0111110"};
+    static const char* kTalk2[2] = {"0111110", "0111110"};
+    static const char* kLine[1] = {"0111110"};
+    static const char* kSmile[2] = {"1000001", "0111110"};
+    static const char* kFrown[2] = {"0111110", "1000001"};
+    static const char* kDots[1] = {"0101010"};
+    static const char* kRest[1] = {"0011100"};
+    const char* const* m = kRest;
+    int rows = 1;
+    if (s == EyeState::Speaking) { if (L > 0.55f) { m = kTalk3; rows = 3; } else if (L > 0.2f) { m = kTalk2; rows = 2; } else m = kLine; }
+    else if (e == Emotion::Happy) { m = kSmile; rows = 2; }
+    else if (e == Emotion::Sad) { m = kFrown; rows = 2; }
+    else if (s == EyeState::Thinking) m = kDots;
+    for (int r = 0; r < rows; r++) for (int c = 0; c < 7; c++) if (m[r][c] == '1') block(6 + c, 13 + r, (int)(210 * bright_));
+}
+
+// ---------------- EYE: one realistic eye ----------------
+void Eyes::DrawRealEye() {
+    const EyeState s = state_;
+    const Emotion e = emotion_;
+    const float cx = 60, cy = 50, A = 40, Bv = 23;
+    float open = 1;
+    if (s == EyeState::Sleep || e == Emotion::Sleepy) open = 0.28f;
+    if (e == Emotion::Surprised) open = 1.22f;
+    if (s == EyeState::Listening) open = 1.08f;
+    open *= 1 - blink_;
+    const float lower = e == Emotion::Happy ? 0.55f : 1;
+    const float Ri = 14, gx = (gx_ + mx_) * A * 0.42f, gy = (gy_ + my_) * Bv * 0.4f;
+    const float pr = Ri * (0.26f + 0.28f * pupil_);
+    const float tilt = e == Emotion::Angry ? 0.25f : e == Emotion::Sad ? -0.2f : 0;
+    for (int x = (int)(cx - A - 3); x <= cx + A + 3; x++) {
+        const float dx = x - cx, nx = dx / A;
+        if (fabsf(nx) > 1) continue;
+        const float shape = powf(1 - nx * nx, 0.62f);
+        const float up = -Bv * open * shape + tilt * dx * 0.3f, lo = Bv * 0.95f * lower * shape;
+        for (int y = (int)floorf(cy - Bv * 1.4f - 4); y <= cy + Bv * 1.3f; y++) {
+            const float dy = y - cy, du = dy - up, dl = lo - dy;
+            if (du < 0 && du > -5 && fabsf(nx) < 0.9f) {
+                if (((x + 400) % 4 == 0) && du > -4 * (1 - fabsf(nx) * 0.7f)) PUT(x + lroundf(nx * 2 * (du / 4)), y, 110 * bright_);
+            }
+            if (fabsf(du) < 0.9f && fabsf(nx) < 0.98f) PUT(x, y, 150 * bright_);
+            if (du < 0 || dl < 0) continue;
+            float v = 150 * (1 - 0.55f * (nx * nx + (dy / Bv) * (dy / Bv)));
+            v *= 0.55f + 0.45f * sstep(0, 6, du);
+            const float ix = dx - gx, iy = dy - gy, ir = sqrtf(ix * ix + iy * iy);
+            if (ir < Ri) {
+                const float a = fast_atan2(iy, ix), rn = ir / Ri;
+                const float fib = 0.55f + 0.45f * (0.5f + 0.5f * sinf(a * 23 + sinf(a * 7) * 2 + rn * 6)) *
+                                              (0.65f + 0.35f * sinf(a * 41 + rn * 11));
+                const float ring = (rn - 0.5f) / 0.12f;
+                float iv = (70 + 120 * fib) * (0.75f + 0.5f * expf(-ring * ring));
+                if (rn > 0.86f) iv *= 1 - (rn - 0.86f) / 0.14f * 0.75f;
+                if (ir < pr) iv = 6;
+                else if (ir < pr + 1) iv = std::min(iv, 40.0f);
+                v = iv * (0.6f + 0.4f * sstep(0, 7, du));
+            }
+            const float h1x = ix + Ri * 0.38f, h1y = iy + Ri * 0.42f, h1 = sqrtf(h1x * h1x + h1y * h1y);
+            const float h2x = ix - Ri * 0.3f, h2y = iy - Ri * 0.38f, h2 = sqrtf(h2x * h2x + h2y * h2y);
+            if (h1 < 3.2f) v = std::max(v, 255 * (1 - h1 / 3.2f) + 120);
+            if (h2 < 1.4f) v = std::max(v, 200.0f);
+            PUT(x, y, v * bright_);
+        }
+    }
+}
+
+// ---------------- text layouts ----------------
+void Eyes::DrawHudMinimal() {
+    const uint8_t hi = 235, dim = 120;
+    const char* kStatus[] = {"", "слушаю", "думаю", "", "подключение", "нет связи", ""};
+    std::u32string st = notification_left_ > 0 ? notification_ : U(kStatus[(int)state_]);
+    if (st.size() > 28) st.resize(28);
+    if (!st.empty()) DrawText(st, (SW - CV_FONT_W * (int)st.size()) / 2, 8, dim);
+    std::u32string shown = message_.substr(0, (size_t)message_shown_);
+    std::u32string lines[2];
+    const int n = Wrap(shown, 26, lines, 2);
+    for (int i = 0; i < n; i++) {
+        DrawText(lines[i], (SW - CV_FONT_W * (int)lines[i].size()) / 2, 206 + i * 14, role_ == Role::User ? dim : hi);
+    }
+}
+
+void Eyes::DrawHudHolo() {
+    const uint8_t hi = 230, dim = 130;
+    std::u32string head = header_;
+    if (head.size() > 18) head.resize(18);
+    DrawText(head, 6, 4, hi);
+    DrawText(unit_, 6, 16, dim);
+    if (battery_ >= 0) {
+        std::u32string b = (charging_ ? U"+" : U"") + U(std::to_string(battery_).c_str()) + U"%";
+        DrawText(b, SW - 6 - CV_FONT_W * (int)b.size(), 4, dim);
+    }
+    const char* kEn[] = {"STANDBY", "LISTENING", "ANALYSIS", "OUTPUT", "LINK", "NO SIGNAL", "SLEEP"};
+    std::u32string st = notification_left_ > 0 ? notification_ : U(kEn[(int)state_]);
+    if (st.size() > 14) st.resize(14);
+    DrawText(st, SW - 6 - CV_FONT_W * (int)st.size(), 16, dim);
+    if (hexh_t_ < 0 || t_ - hexh_t_ > 0.4f) {
+        hexh_t_ = t_;
+        for (auto& h : hexh_) {
+            char buf[8];
+            snprintf(buf, sizeof(buf), "%04X", (unsigned)(Rand() & 0xffff));
+            h = U(buf);
+        }
+    }
+    for (int i = 0; i < 4; i++) {
+        DrawText(hexh_[i], 4, 70 + i * 13, 90);
+        std::u32string r(hexh_[i].rbegin(), hexh_[i].rend());
+        DrawText(r, SW - 36, 70 + i * 13, 90);
+    }
+    DrawMessage(208, 2, false);
+}
+
+void Eyes::DrawHudPixel() {
+    const char* kEn[] = {"READY", "LISTEN", "WAIT...", "TALK", "LOADING", "GAME OVER", "ZZZ"};
+    std::u32string st = notification_left_ > 0 ? notification_ : U(kEn[(int)state_]);
+    if (st.size() > 28) st.resize(28);
+    DrawText(st, (SW - CV_FONT_W * (int)st.size()) / 2, 4, 200);
+    DrawMessage(208, 2, false);
+}
+
+#undef PUT
+
+}  // namespace cv
