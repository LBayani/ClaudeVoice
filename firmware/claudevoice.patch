+};
+
+}  // namespace cv
diff --git a/main/boards/claudevoice-common/cv_eyes_display.h b/main/boards/claudevoice-common/cv_eyes_display.h
new file mode 100644
index 0000000..0bf88f2
--- /dev/null
+++ b/main/boards/claudevoice-common/cv_eyes_display.h
@@ -0,0 +1,326 @@
+// Full-screen CRT robot eyes on top of the stock LCD UI.
+#pragma once
+
+#include "zhengchen_lcd_display.h"
+#include "cv_eyes.h"
+#include "cv_audio_level.h"
+#include "application.h"
+#include "board.h"
+#include "settings.h"
+
+#include <cJSON.h>
+#include <mbedtls/base64.h>
+#include <esp_heap_caps.h>
+#include <esp_log.h>
+#include <esp_timer.h>
+#include <algorithm>
+#include <cstring>
+#include <ctime>
+#include <string>
+
+class CvEyesDisplay : public ZHENGCHEN_LcdDisplay {
+public:
+    CvEyesDisplay(esp_lcd_panel_io_handle_t panel_io, esp_lcd_panel_handle_t panel,
+                  int width, int height, int offset_x, int offset_y,
+                  bool mirror_x, bool mirror_y, bool swap_xy)
+        : ZHENGCHEN_LcdDisplay(panel_io, panel, width, height, offset_x, offset_y, mirror_x, mirror_y, swap_xy) {}
+
+    void SetupUI() override {
+        ZHENGCHEN_LcdDisplay::SetupUI();
+        DisplayLockGuard lock(this);
+        buf_ = (uint16_t*)heap_caps_aligned_alloc(64, cv::Eyes::SW * cv::Eyes::SH * 2, MALLOC_CAP_SPIRAM);
+        if (!buf_ || !eyes_.ok()) {
+            ESP_LOGE("CvEyes", "Out of PSRAM, keeping stock UI");
+            return;
+        }
+        memset(buf_, 0, cv::Eyes::SW * cv::Eyes::SH * 2);
+        {
+            Settings settings("cv", false);
+            eyes_.SetPalette(settings.GetInt("palette", 0));
+            eyes_.SetStyle(settings.GetInt("style", 0));
+        }
+        lv_obj_t* scr = lv_screen_active();
+        // Hide the stock UI so LVGL doesn't draw it under the canvas.
+        for (uint32_t i = 0; i < lv_obj_get_child_count(scr); i++) {
+            lv_obj_add_flag(lv_obj_get_child(scr, i), LV_OBJ_FLAG_HIDDEN);
+        }
+        canvas_ = lv_canvas_create(scr);
+        lv_canvas_set_buffer(canvas_, buf_, cv::Eyes::SW, cv::Eyes::SH, LV_COLOR_FORMAT_RGB565);
+        // The eyes are drawn at 240x240: centre them on other screens, shrink them on smaller ones.
+        lv_obj_center(canvas_);
+        const int fit = std::min(width_, height_);
+        if (fit < cv::Eyes::SW) {
+            lv_obj_set_style_transform_pivot_x(canvas_, cv::Eyes::SW / 2, 0);
+            lv_obj_set_style_transform_pivot_y(canvas_, cv::Eyes::SH / 2, 0);
+            lv_obj_set_style_transform_scale(canvas_, 256 * fit / cv::Eyes::SW, 0);
+        }
+        lv_obj_set_style_bg_color(scr, lv_color_black(), 0);
+        lv_obj_remove_flag(canvas_, LV_OBJ_FLAG_SCROLLABLE);
+        last_us_ = esp_timer_get_time();
+        timer_ = lv_timer_create(TimerCb, kFrameMs, this);
+        ESP_LOGI("CvEyes", "Eyes UI started (%d ms/frame)", kFrameMs);
+    }
+
+    void SetStatus(const char* status) override { ZHENGCHEN_LcdDisplay::SetStatus(status); }
+
+    // ---- driven by MCP tools (Claude) ----
+    bool SetEyeColor(const std::string& color) {
+        int p = color == "green" ? 1 : color == "amber" ? 0 : -1;
+        if (p < 0) return false;
+        {
+            DisplayLockGuard lock(this);
+            eyes_.SetPalette(p);
+        }
+        Settings settings("cv", true);
+        settings.SetInt("palette", p);
+        return true;
+    }
+
+    static int StyleFromName(const std::string& n) {
+        static const char* kNames[] = {"classic", "circuit", "pixel", "hud", "orb", "pet", "minimal", "eye"};
+        for (int i = 0; i < cv::kStyleCount; i++) if (n == kNames[i]) return i;
+        return -1;
+    }
+
+    bool SetEyeStyle(const std::string& style) {
+        int s = StyleFromName(style);
+        if (s < 0) return false;
+        {
+            DisplayLockGuard lock(this);
+            eyes_.SetStyle(s);
+        }
+        Settings settings("cv", true);
+        settings.SetInt("style", s);
+        return true;
+    }
+
+    // Download a skin JSON (voice_server /skins/<id>.json) and apply it. Blocking: call from a task.
+    std::string LoadSkinFromUrl(const std::string& url) {
+        auto network = Board::GetInstance().GetNetwork();
+        if (!network) return "no network";
+        auto http = network->CreateHttp(0);
+        if (!http->Open("GET", url)) return "cannot connect to " + url;
+        const int status = http->GetStatusCode();
+        if (status != 200) {
+            http->Close();
+            return "HTTP " + std::to_string(status);
+        }
+        // Read in pieces: Http::ReadAll() deadlocks on bodies > 8 KB (the receiver waits for the buffer
+        // to be drained while ReadAll waits for EOF), and skins with a background are ~20 KB.
+        std::string body;
+        char chunk[2048];
+        for (;;) {
+            const int n = http->Read(chunk, sizeof(chunk));
+            if (n <= 0) break;
+            body.append(chunk, n);
+            if (body.size() > 256 * 1024) break;   // sanity limit
+        }
+        http->Close();
+
+        cJSON* root = cJSON_Parse(body.c_str());
+        if (!root) return "bad skin JSON";
+        cv::Skin s;
+        auto str = [&](const char* k) { cJSON* v = cJSON_GetObjectItem(root, k); return cJSON_IsString(v) ? std::string(v->valuestring) : std::string(); };
+        s.style = std::max(0, StyleFromName(str("base")));
+        if (cJSON* f = cJSON_GetObjectItem(root, "fx"); cJSON_IsObject(f)) {
+            s.has_fx = true;
+            s.fx = cv::Eyes::DefaultFxFor(s.style);
+            auto fnum = [&](const char* k, float def) { cJSON* v = cJSON_GetObjectItem(f, k); return cJSON_IsNumber(v) ? (float)v->valuedouble : def; };
+            s.fx.scan = fnum("scan", s.fx.scan);
+            s.fx.noise = (int)fnum("noise", s.fx.noise);
+            s.fx.flicker = fnum("flicker", s.fx.flicker) > 0.5f;
+            s.fx.vign = fnum("vign", s.fx.vign) > 0.5f;
+            s.fx.smooth = fnum("smooth", s.fx.smooth) > 0.5f;
+            s.fx.decay = fnum("decay", s.fx.decay);
+        }
+        const std::string pal = str("palette565");
+        if (pal.size() == 256 * 4) {
+            s.has_palette = true;
+            for (int i = 0; i < 256; i++) s.palette[i] = (uint16_t)strtoul(pal.substr(i * 4, 4).c_str(), nullptr, 16);
+        }
+        const std::string bg64 = str("background");
+        if (!bg64.empty()) {
+            s.background.resize(cv::Eyes::LW * cv::Eyes::LH + 8);
+            size_t out = 0;
+            if (mbedtls_base64_decode((unsigned char*)s.background.data(), s.background.size(), &out,
+                                      (const unsigned char*)bg64.data(), bg64.size()) == 0) {
+                s.background.resize(out);
+            } else {
+                s.background.clear();
+            }
+        }
+        if (cJSON* e = cJSON_GetObjectItem(root, "eyes"); cJSON_IsObject(e)) {
+            auto num = [&](const char* k) { cJSON* v = cJSON_GetObjectItem(e, k); return cJSON_IsNumber(v) ? v->valueint : 0; };
+            s.has_eyes = true;
+            s.lx = num("lx"); s.ly = num("ly"); s.rx = num("rx"); s.ry = num("ry"); s.r = num("r");
+            if (s.r < 6) s.has_eyes = false;
+        }
+        if (cJSON* t = cJSON_GetObjectItem(root, "texts"); cJSON_IsObject(t)) {
+            cJSON* u = cJSON_GetObjectItem(t, "unit");
+            cJSON* h = cJSON_GetObjectItem(t, "header");
+            if (cJSON_IsString(u)) s.unit = u->valuestring;
+            if (cJSON_IsString(h)) s.header = h->valuestring;
+        }
+        const std::string id = str("id");
+        cJSON_Delete(root);
+        {
+            DisplayLockGuard lock(this);
+            eyes_.ApplySkin(s);
+        }
+        ESP_LOGI("CvEyes", "skin '%s' applied (style %d, palette %d, bg %d)", id.c_str(), s.style,
+                 s.has_palette, (int)!s.background.empty());
+        return "ok: " + id;
+    }
+
+    bool ShowEyeEmotion(const std::string& name, int seconds) {
+        static const std::pair<const char*, cv::Emotion> kMap[] = {
+            {"neutral", cv::Emotion::Neutral}, {"happy", cv::Emotion::Happy}, {"sad", cv::Emotion::Sad},
+            {"angry", cv::Emotion::Angry}, {"surprised", cv::Emotion::Surprised},
+            {"thinking", cv::Emotion::Thinking}, {"sleepy", cv::Emotion::Sleepy},
+        };
+        for (auto& [n, e] : kMap) {
+            if (name == n) {
+                DisplayLockGuard lock(this);
+                eyes_.SetEmotion(e);
+                emotion_hold_ = seconds > 0 ? (float)seconds : 5.0f;
+                return true;
+            }
+        }
+        return false;
+    }
+
+    void ShowNotification(const char* notification, int duration_ms = 3000) override {
+        DisplayLockGuard lock(this);
+        eyes_.SetNotification(notification ? notification : "", duration_ms / 1000.0f);
+    }
+    void ShowNotification(const std::string& notification, int duration_ms = 3000) override {
+        ShowNotification(notification.c_str(), duration_ms);
+    }
+
+    void SetEmotion(const char* emotion) override {
+        if (!emotion) return;
+        DisplayLockGuard lock(this);
+        std::string e = emotion;
+        thinking_ = (e == "thinking");
+        if (emotion_hold_ > 0 && e != "circle_xmark" && e != "triangle_exclamation") {
+            return;  // an emotion chosen via MCP tool wins for a few seconds
+        }
+        error_hold_ = 0;
+        if (e == "happy" || e == "laughing" || e == "funny" || e == "loving" || e == "winking" ||
+            e == "cool" || e == "relaxed" || e == "delicious" || e == "kissy" || e == "confident" || e == "silly") {
+            eyes_.SetEmotion(cv::Emotion::Happy);
+        } else if (e == "sad" || e == "crying") {
+            eyes_.SetEmotion(cv::Emotion::Sad);
+        } else if (e == "angry") {
+            eyes_.SetEmotion(cv::Emotion::Angry);
+        } else if (e == "surprised" || e == "shocked" || e == "embarrassed" || e == "confused") {
+            eyes_.SetEmotion(cv::Emotion::Surprised);
+        } else if (e == "thinking") {
+            eyes_.SetEmotion(cv::Emotion::Thinking);
+        } else if (e == "sleepy") {
+            eyes_.SetEmotion(cv::Emotion::Sleepy);
+        } else if (e == "circle_xmark" || e == "triangle_exclamation") {
+            error_hold_ = 6.0f;  // Alert(): show the error look for a while
+            eyes_.SetEmotion(cv::Emotion::Neutral);
+        } else {
+            eyes_.SetEmotion(cv::Emotion::Neutral);
+        }
+    }
+
+    void SetChatMessage(const char* role, const char* content) override {
+        DisplayLockGuard lock(this);
+        std::string r = role ? role : "system";
+        cv::Role rr = r == "user" ? cv::Role::User : r == "assistant" ? cv::Role::Assistant : cv::Role::System;
+        eyes_.SetMessage(rr, content ? content : "");
+    }
+
+    void ClearChatMessages() override {
+        DisplayLockGuard lock(this);
+        eyes_.SetMessage(cv::Role::System, "");
+    }
+
+    void SetPowerSaveMode(bool on) override {
+        DisplayLockGuard lock(this);
+        sleep_ = on;
+    }
+
+private:
+    static constexpr int kFrameMs = 40;   // 25 fps
+    cv::Eyes eyes_;
+    uint16_t* buf_ = nullptr;
+    lv_obj_t* canvas_ = nullptr;
+    lv_timer_t* timer_ = nullptr;
+    int64_t last_us_ = 0;
+    float battery_timer_ = 0;
+    float error_hold_ = 0;
+    float emotion_hold_ = 0;
+    float render_ms_avg_ = 0;
+    uint32_t period_ = kFrameMs;
+    int64_t last_perf_log_ = 0;
+    bool thinking_ = false;
+    bool sleep_ = false;
+
+    static void TimerCb(lv_timer_t* t) {
+        static_cast<CvEyesDisplay*>(lv_timer_get_user_data(t))->Frame();
+    }
+
+    // Runs inside the LVGL task (display lock already held).
+    void Frame() {
+        const int64_t now = esp_timer_get_time();
+        float dt = (now - last_us_) / 1e6f;
+        last_us_ = now;
+        if (dt > 0.1f) dt = 0.1f;
+
+        auto state = Application::GetInstance().GetDeviceState();
+        cv::EyeState es = cv::EyeState::Idle;
+        switch (state) {
+            case kDeviceStateListening: es = thinking_ ? cv::EyeState::Thinking : cv::EyeState::Listening; break;
+            case kDeviceStateSpeaking: es = cv::EyeState::Speaking; thinking_ = false; break;
+            case kDeviceStateStarting: case kDeviceStateConnecting: case kDeviceStateActivating:
+            case kDeviceStateUpgrading: case kDeviceStateWifiConfiguring: case kDeviceStateUnknown:
+                es = cv::EyeState::Connecting; break;
+            case kDeviceStateFatalError: es = cv::EyeState::Error; break;
+            default: es = cv::EyeState::Idle; thinking_ = false; break;
+        }
+        if (emotion_hold_ > 0) emotion_hold_ -= dt;
+        if (error_hold_ > 0) { error_hold_ -= dt; if (es == cv::EyeState::Idle) es = cv::EyeState::Error; }
+        if (sleep_ && es == cv::EyeState::Idle) es = cv::EyeState::Sleep;
+        eyes_.SetState(es);
+
+        // voice level: speaker while speaking, mic while listening
+        float level = 0;
+        if (es == cv::EyeState::Speaking && now - cv::g_spk_time_us.load() < 150000) level = cv::g_spk_level.load();
+        if (es == cv::EyeState::Listening && now - cv::g_mic_time_us.load() < 150000) level = cv::g_mic_level.load();
+        eyes_.SetLevel(level);
+
+        battery_timer_ -= dt;
+        if (battery_timer_ <= 0) {
+            battery_timer_ = 5;
+            int lvl = 0; bool charging = false, discharging = false;
+            if (Board::GetInstance().GetBatteryLevel(lvl, charging, discharging)) eyes_.SetBattery(lvl, charging);
+            time_t tt = time(nullptr);
+            struct tm tmv;
+            localtime_r(&tt, &tmv);
+            if (tmv.tm_year > 120) {
+                char hhmm[8];
+                strftime(hhmm, sizeof(hhmm), "%H:%M", &tmv);
+                eyes_.SetClock(hhmm);
+            }
+        }
+
+        eyes_.Update(dt);
+        const int64_t r0 = esp_timer_get_time();
+        eyes_.Render(buf_);
+        lv_obj_invalidate(canvas_);
+        // Never let rendering eat the whole core: stretch the frame period if a frame is slow.
+        const int render_ms = (int)((esp_timer_get_time() - r0) / 1000);
+        render_ms_avg_ = render_ms_avg_ * 0.9f + render_ms * 0.1f;
+        // ~60% of one core at most: leaves room for LVGL's own flush, audio and Wi-Fi.
+        const uint32_t period = std::max<int>(kFrameMs, (int)(render_ms_avg_ * 1.6f) + 12);
+        if (period != period_) { period_ = period; lv_timer_set_period(timer_, period); }
+        if (now - last_perf_log_ > 30000000) {
+            last_perf_log_ = now;
+            ESP_LOGI("CvEyes", "render %.1f ms, frame period %u ms", render_ms_avg_, (unsigned)period);
+        }
+    }
+};
