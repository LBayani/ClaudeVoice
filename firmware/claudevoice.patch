+// CRT phosphor robot-eyes engine (port of proto/eyes_engine.js). No LVGL dependency.
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+namespace cv {
+
+std::u32string Utf8ToU32(const std::string& s);
+
+enum class EyeState { Idle, Listening, Thinking, Speaking, Connecting, Error, Sleep };
+
+// Post-processing of a skin (see proto/skins_render.js SKIN_FX).
+struct Fx {
+    float scan = 0.68f;    // brightness of odd rows, 1 = no scanlines
+    int noise = 7;         // random grain amplitude
+    bool flicker = true, vign = true, smooth = false;
+    float decay = 0.55f;   // phosphor persistence
+    int hud = 0;           // 0 crt, 1 circuit, 2 pixel, 3 holo, 4 minimal
+};
+
+enum SkinStyle { kClassic = 0, kCircuit, kPixel, kHolo, kOrb, kPet, kMinimal, kRealEye, kStyleCount };
+
+// A screen skin downloaded from the server (see voice_server/skins.py).
+struct Skin {
+    bool has_fx = false;
+    Fx fx;
+    int style = 0;                       // SkinStyle
+    bool has_palette = false;
+    uint16_t palette[256] = {};          // RGB565 per phosphor intensity
+    std::string background;              // 120*120 intensity bytes, empty = none
+    bool has_eyes = false;
+    int lx = 0, ly = 0, rx = 0, ry = 0, r = 0;
+    std::string unit, header;            // HUD texts (UTF-8), empty = default
+};
+enum class Emotion { Neutral, Happy, Sad, Angry, Surprised, Thinking, Sleepy };
+enum class Role { System, User, Assistant };
+
+class Eyes {
+public:
+    static constexpr int SW = 240, SH = 240, LW = 120, LH = 120;
+
+    Eyes();
+    ~Eyes();
+    bool ok() const { return phos_ != nullptr; }
+
+    void SetState(EyeState s);
+    void SetEmotion(Emotion e);
+    void SetMessage(Role role, const std::string& utf8);
+    void SetNotification(const std::string& utf8, float seconds);
+    void SetLevel(float v);                 // 0..1 voice level (mic or speaker)
+    void SetBattery(int percent, bool charging) { battery_ = percent; charging_ = charging; }
+    void SetPalette(int p) { palette_ = p; has_custom_pal_ = false; }   // 0 amber, 1 green
+    void ApplySkin(const Skin& s);
+    static Fx DefaultFxFor(int style) { return DefaultFx(style); }
+    void SetStyle(int s) { style_ = s; }       // 0 classic lenses, 1 circuit face
+    int style() const { return style_; }
+    void SetClock(const char* hhmm) { clock_ = Utf8ToU32(hhmm ? hhmm : ""); }
+    EyeState state() const { return state_; }
+
+    void Update(float dt);
+    void Render(uint16_t* rgb565);          // SW*SH native RGB565
+
+private:
+    void BuildPalettes();
+    void DrawEye(float cx, float cy, float R, int side);
+    void DrawScope();
+    void DrawHud();
+    void DrawText(const char32_t* s, int n, int x, int y, uint8_t v);
+    void DrawText(const std::u32string& s, int x, int y, uint8_t v) { DrawText(s.data(), (int)s.size(), x, y, v); }
+    void DrawMessage(int y0, int max_lines, bool cursor);
+    // circuit-face style
+    void BuildCircuit();
+    void SLine(int x0, int y0, int x1, int y1, uint8_t v);
+    void SRing(float cx, float cy, float r, uint8_t v);
+    void DrawEyeCircuit(float cx, float cy, float R, int side);
+    void DrawMouth();
+    void DrawSpectrum();
+    void DrawHudCircuit();
+    // modern / extra skins (cv_skins.cc)
+    void DrawOrb();
+    void DrawPet();
+    void DrawMinimal();
+    void DrawHoloCore();
+    void DrawPixel();
+    void DrawRealEye();
+    void Dot(float cx, float cy, float r, float v);
+    void RingPx(float cx, float cy, float r, float v);
+    void DrawHudMinimal();
+    void DrawHudHolo();
+    void DrawHudPixel();
+    void Composite(uint16_t* out, const Fx& fx);
+    static Fx DefaultFx(int style);
+    inline void Put(int x, int y, float v);
+    uint32_t Rand();
+    float Rnd(float a, float b);
+
+    inline void PutText(int x, int y, uint8_t v);   // HUD pixels go straight into the output frame
+
+    uint8_t* phos_ = nullptr;   // LW*LH, internal RAM when possible
+    uint8_t colf_[SW] = {};     // separable vignette: column factor
+    uint8_t rowf_[SH] = {};     // separable vignette: row factor
+    uint8_t colk_[SW] = {};     // per-frame column gain (vignette on/off)
+    bool has_fx_ = false;
+    Fx skin_fx_;
+    std::u32string hexh_[4];
+    float hexh_t_ = -1;
+    int rowk_[SH] = {};         // per-frame row gain (rowf * flicker)
+    uint16_t* out_ = nullptr;   // frame being rendered
+    const uint16_t* cur_pal_ = nullptr;
+    int8_t row_shift_[SH] = {};
+    uint16_t pal_[3][256] = {};
+    int palette_ = 0;
+    int style_ = 0;
+    bool has_custom_pal_ = false;
+    uint16_t custom_pal_[256] = {};
+    uint8_t* bg_ = nullptr;             // skin background layer, LW*LH
+    bool skin_eyes_ = false;
