+    std::u32string unit_ = U"UNIT-07", header_ = U"VOICE INTERFACE";
+    uint8_t* circuit_ = nullptr;  // static traces layer, LW*LH
+    float spec_[6] = {};
+    std::u32string hex_[3];
+    float hex_t_ = -1;
+    uint32_t rng_ = 0x12345678;
+    float t_ = 0;
+    float decay_ = 0.55f;
+
+    EyeState state_ = EyeState::Idle;
+    float state_t_ = 0;
+    Emotion emotion_ = Emotion::Neutral;
+    float emotion_t_ = 0;
+
+    std::u32string message_;
+    float message_shown_ = 0;
+    Role role_ = Role::System;
+    std::u32string notification_;
+    float notification_left_ = 0;
+    std::u32string clock_;
+    int battery_ = -1;
+    bool charging_ = false;
+
+    float gx_ = 0, gy_ = 0, tgx_ = 0, tgy_ = 0, next_saccade_ = 1;
+    float mx_ = 0, my_ = 0, next_micro_ = 0.3f;
+    float blink_ = 0, blink_phase_ = -1, next_blink_ = 2;
+    bool double_blink_ = false;
