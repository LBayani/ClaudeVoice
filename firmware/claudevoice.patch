diff --git a/main/boards/claudevoice-common/cv_eyes.cc b/main/boards/claudevoice-common/cv_eyes.cc
new file mode 100644
index 0000000..309ee78
--- /dev/null
+++ b/main/boards/claudevoice-common/cv_eyes.cc
@@ -0,0 +1,716 @@
+#include "cv_eyes.h"
+#include "cv_font.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <esp_heap_caps.h>
+
+namespace cv {
+
+namespace {
+constexpr float kPi = 3.14159265f;
+inline float clampf(float v, float a, float b) { return v < a ? a : (v > b ? b : v); }
+inline float lerpf(float a, float b, float t) { return a + (b - a) * t; }
+inline float approach(float cur, float target, float rate, float dt) {
+    return cur + (target - cur) * (1.0f - expf(-rate * dt));
+}
+inline float fract(float v) { return v - floorf(v); }
+
+const char32_t* StatusText(EyeState s) {
+    switch (s) {
+        case EyeState::Idle: return U"ГОТОВ";
+        case EyeState::Listening: return U"СЛУШАЮ";
+        case EyeState::Thinking: return U"ОБРАБОТКА";
+        case EyeState::Speaking: return U"ГОВОРЮ";
+        case EyeState::Connecting: return U"СОЕДИНЕНИЕ";
+        case EyeState::Error: return U"НЕТ СВЯЗИ";
+        case EyeState::Sleep: return U"ОЖИДАНИЕ";
+    }
+    return U"";
+}
+
+const uint8_t* Glyph(char32_t c) {
+    int lo = 0, hi = CV_FONT_COUNT - 1;
+    while (lo <= hi) {
+        int mid = (lo + hi) / 2;
+        if (cv_font_codes[mid] == c) return cv_font_bits[mid];
+        if (cv_font_codes[mid] < c) lo = mid + 1; else hi = mid - 1;
+    }
+    return c == U'?' ? nullptr : Glyph(U'?');
+}
+}  // namespace
+
+std::u32string Utf8ToU32(const std::string& s) {
+    std::u32string out;
+    out.reserve(s.size());
+    for (size_t i = 0; i < s.size();) {
+        uint8_t c = s[i];
+        char32_t cp;
+        int n;
+        if (c < 0x80) { cp = c; n = 1; }
+        else if ((c >> 5) == 6) { cp = c & 0x1f; n = 2; }
+        else if ((c >> 4) == 14) { cp = c & 0x0f; n = 3; }
+        else if ((c >> 3) == 30) { cp = c & 0x07; n = 4; }
+        else { i++; continue; }
+        if (i + n > s.size()) break;
+        for (int k = 1; k < n; k++) cp = (cp << 6) | (s[i + k] & 0x3f);
+        i += n;
+        out.push_back(cp);
+    }
+    return out;
+}
+
+Eyes::Eyes() {
+    // 14 KB phosphor layer is read 4x per output pixel: keep it in fast internal RAM.
+    phos_ = (uint8_t*)heap_caps_calloc(LW * LH, 1, MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
+    if (!phos_) phos_ = (uint8_t*)heap_caps_calloc(LW * LH, 1, MALLOC_CAP_SPIRAM);
+    for (int i = 0; i < SW; i++) {
+        const float d = (i - SW / 2.0f) / (SW / 2.0f), d2 = d * d;
+        const float f = clampf(1.02f - 0.08f * d2 * d2 - 0.03f * d2, 0, 1);   // separable vignette
+        colf_[i] = (uint8_t)(f * 255);
+        rowf_[i] = (uint8_t)(f * 255);
+    }
+    BuildPalettes();
+}
+
+Eyes::~Eyes() {
+    heap_caps_free(phos_);
+    heap_caps_free(circuit_);
+    heap_caps_free(bg_);
+}
+
+void Eyes::ApplySkin(const Skin& s) {
+    style_ = s.style;
+    has_custom_pal_ = s.has_palette;
+    if (s.has_palette) memcpy(custom_pal_, s.palette, sizeof(custom_pal_));
+    if (s.background.size() == (size_t)(LW * LH)) {
+        if (!bg_) bg_ = (uint8_t*)heap_caps_malloc(LW * LH, MALLOC_CAP_SPIRAM);
+        if (bg_) memcpy(bg_, s.background.data(), LW * LH);
+    } else if (bg_) {
+        heap_caps_free(bg_);
+        bg_ = nullptr;
+    }
+    has_fx_ = s.has_fx;
+    skin_fx_ = s.fx;
+    skin_eyes_ = s.has_eyes;
+    sk_lx_ = s.lx; sk_ly_ = s.ly; sk_rx_ = s.rx; sk_ry_ = s.ry; sk_r_ = s.r;
+    unit_ = s.unit.empty() ? std::u32string(U"UNIT-07") : Utf8ToU32(s.unit);
+    header_ = s.header.empty() ? std::u32string(U"VOICE INTERFACE") : Utf8ToU32(s.header);
+    glitch_ = 0.3f;   // a little CRT hiccup when the skin changes
+}
+
+inline void Eyes::PutText(int x, int y, uint8_t v) {
+    if (!out_ || x < 0 || y < 0 || x >= SW || y >= SH) return;
+    int c = ((v * colk_[x]) >> 8) * rowk_[y] >> 8;
+    out_[y * SW + x] = cur_pal_[c > 255 ? 255 : c];
+}
+
+void Eyes::BuildPalettes() {
+    for (int i = 0; i < 256; i++) {
+        float f = i / 255.0f;
+        float rgb[3][3] = {
+            // amber
+            {255 * powf(f, 0.55f), 175 * powf(f, 0.95f) + 70 * powf(f, 6), 30 * f * f + 150 * powf(f, 6)},
+            // green
+            {40 * f * f + 200 * powf(f, 6), 255 * powf(f, 0.75f), 80 * f * f + 170 * powf(f, 6)},
+            // red (error)
+            {255 * powf(f, 0.7f), 70 * f * f + 160 * powf(f, 6), 40 * f * f + 120 * powf(f, 6)},
+        };
+        for (int p = 0; p < 3; p++) {
+            int r = (int)clampf(rgb[p][0], 0, 255), g = (int)clampf(rgb[p][1], 0, 255), b = (int)clampf(rgb[p][2], 0, 255);
+            pal_[p][i] = (uint16_t)(((r & 0xf8) << 8) | ((g & 0xfc) << 3) | (b >> 3));
+        }
+    }
+}
+
+uint32_t Eyes::Rand() {
+    rng_ ^= rng_ << 13; rng_ ^= rng_ >> 17; rng_ ^= rng_ << 5;
+    return rng_;
+}
+float Eyes::Rnd(float a, float b) { return a + (Rand() & 0xffffff) / 16777216.0f * (b - a); }
+
+void Eyes::SetState(EyeState s) {
+    if (s == state_) return;
+    state_ = s;
+    state_t_ = 0;
+    glitch_ = 0.18f;
+    next_saccade_ = 0;
+    if (s == EyeState::Listening || s == EyeState::Error) blink_phase_ = 0;
+}
+
+void Eyes::SetEmotion(Emotion e) { emotion_ = e; emotion_t_ = 0; }
+
+void Eyes::SetMessage(Role role, const std::string& utf8) {
+    role_ = role;
+    message_ = Utf8ToU32(utf8);
+    message_shown_ = 0;
+}
+
+void Eyes::SetNotification(const std::string& utf8, float seconds) {
+    notification_ = Utf8ToU32(utf8);
+    notification_left_ = seconds;
+}
+
+void Eyes::SetLevel(float v) { level_target_ = clampf(v, 0, 1); }
+
+void Eyes::Update(float dt) {
+    t_ += dt; state_t_ += dt; emotion_t_ += dt;
+    const EyeState s = state_;
+
+    next_saccade_ -= dt;
+    if (next_saccade_ <= 0) {
+        switch (s) {
+            case EyeState::Listening: tgx_ = Rnd(-0.12f, 0.12f); tgy_ = Rnd(-0.08f, 0.1f); next_saccade_ = Rnd(0.8f, 2.0f); break;
+            case EyeState::Thinking:
+                tgx_ = Rnd(0.35f, 0.75f) * ((Rand() & 1023) < 716 ? 1 : -1); tgy_ = Rnd(-0.75f, -0.35f);
+                next_saccade_ = Rnd(0.5f, 1.4f); break;
+            case EyeState::Speaking: tgx_ = Rnd(-0.25f, 0.25f); tgy_ = Rnd(-0.1f, 0.15f); next_saccade_ = Rnd(0.6f, 1.8f); break;
+            case EyeState::Sleep: tgx_ = 0; tgy_ = 0.3f; next_saccade_ = 3; break;
+            case EyeState::Connecting: tgx_ = 0; tgy_ = 0; next_saccade_ = 1; break;
+            default: {
+                bool far = (Rand() & 1023) < 256;
+                tgx_ = far ? Rnd(-0.9f, 0.9f) : Rnd(-0.35f, 0.35f);
+                tgy_ = far ? Rnd(-0.6f, 0.6f) : Rnd(-0.2f, 0.25f);
+                next_saccade_ = Rnd(1.2f, 4.0f);
+            }
+        }
+    }
+    gx_ = approach(gx_, tgx_, 28, dt);
+    gy_ = approach(gy_, tgy_, 28, dt);
+    next_micro_ -= dt;
+    if (next_micro_ <= 0) { mx_ = Rnd(-0.04f, 0.04f); my_ = Rnd(-0.03f, 0.03f); next_micro_ = Rnd(0.25f, 0.7f); }
+
+    next_blink_ -= dt;
+    if (blink_phase_ < 0 && next_blink_ <= 0 && s != EyeState::Sleep) {
+        blink_phase_ = 0;
+        double_blink_ = (Rand() & 1023) < 184;
+    }
+    if (blink_phase_ >= 0) {
+        blink_phase_ += dt;
+        const float p = blink_phase_, c = 0.07f, h = 0.04f, o = 0.13f;
+        blink_ = p < c ? p / c : p < c + h ? 1 : p < c + h + o ? 1 - (p - c - h) / o : 0;
+        if (p >= c + h + o) {
+            blink_phase_ = -1; blink_ = 0;
+            if (double_blink_) { double_blink_ = false; next_blink_ = 0.12f; }
+            else next_blink_ = s == EyeState::Listening ? Rnd(3, 6) : Rnd(2, 6.5f);
+        }
+    }
+
+    level_ = approach(level_, level_target_, level_target_ > level_ ? 30 : 9, dt);
+
+    float pupilT = 0.55f, openU = 0.9f, openL = 0.72f, rotSpeed = 0.25f, bright = 0.9f, tilt = 0, happy = 0, tiltR = 0;
+    switch (s) {
+        case EyeState::Listening: pupilT = 0.85f + 0.15f * level_; openU = 1.02f; openL = 0.8f; rotSpeed = 0.5f; bright = 1; tiltR = 0.06f; break;
+        case EyeState::Thinking: pupilT = 0.38f + 0.08f * sinf(t_ * 6); openU = 0.78f; openL = 0.66f; rotSpeed = 2.6f; bright = 0.95f; break;
+        case EyeState::Speaking: pupilT = 0.55f + 0.35f * level_; openU = 0.92f; openL = 0.74f; rotSpeed = 0.6f + 1.5f * level_; bright = 0.95f + 0.05f * level_; break;
+        case EyeState::Connecting: pupilT = 0.3f; openU = 0.7f; openL = 0.6f; rotSpeed = 5; bright = 0.8f; break;
+        case EyeState::Error: pupilT = 0.25f; openU = 0.55f; openL = 0.5f; rotSpeed = 0; bright = 0.85f; tilt = 0.25f; break;
+        case EyeState::Sleep: pupilT = 0.4f; openU = 0.12f + 0.03f * sinf(t_ * 0.8f); openL = 0.1f; rotSpeed = 0.05f; bright = 0.45f + 0.1f * sinf(t_ * 0.8f); break;
+        default: break;
+    }
+    switch (emotion_) {
+        case Emotion::Happy: happy = 1; openU = std::min(openU, 0.9f); break;
+        case Emotion::Sad: tilt = -0.35f; openU *= 0.8f; break;
+        case Emotion::Angry: tilt = 0.45f; openU *= 0.75f; pupilT *= 0.7f; break;
+        case Emotion::Surprised: openU = 1.15f; openL = 0.9f; pupilT = 0.35f; break;
+        case Emotion::Sleepy: openU *= 0.45f; break;
+        default: break;
+    }
+    pupil_ = approach(pupil_, pupilT, 6, dt);
+    open_u_ = approach(open_u_, openU, 10, dt);
+    open_l_ = approach(open_l_, openL, 10, dt);
+    tilt_ = approach(tilt_, tilt, 8, dt);
+    happy_ = approach(happy_, happy, 8, dt);
+    tilt_r_ = approach(tilt_r_, tiltR, 3, dt);
+    bright_ = approach(bright_, bright, 4, dt);
+    iris_rot_ += rotSpeed * dt;
+    glitch_ = std::max(0.0f, glitch_ - dt);
+    if (s == EyeState::Error && Rnd(0, 1) < dt * 1.5f) glitch_ = 0.12f;
+    if (notification_left_ > 0) notification_left_ -= dt;
+
+    if (message_shown_ < message_.size()) message_shown_ = std::min<float>(message_.size(), message_shown_ + dt * 45);
+
+    memmove(scope_, scope_ + 1, sizeof(float) * (LW - 1));
+    float amp = (s == EyeState::Speaking || s == EyeState::Listening) ? level_ : 0;
+    scope_[LW - 1] = amp * (sinf(t_ * 47) * 0.6f + sinf(t_ * 83 + 1) * 0.4f) * (0.6f + 0.4f * Rnd(0, 1));
+}
+
+inline void Eyes::Put(int x, int y, float v) {
+    if (x < 0 || y < 0 || x >= LW || y >= LH) return;
+    int iv = (int)v;
+    if (iv > 255) iv = 255;
+    uint8_t& p = phos_[y * LW + x];
+    if (iv > p) p = (uint8_t)iv;
+}
+
+void Eyes::DrawEye(float cx, float cy, float R, int side) {
+    const float gx = (gx_ + mx_) * R * 0.42f, gy = (gy_ + my_) * R * 0.34f;
+    const float b = blink_;
+    const float tilt = tilt_ * side;
+    const float ou = lerpf(open_u_, -open_l_ * 0.85f, b), ol = open_l_ * (1 - 0.25f * b);
+    const float Ri = R * 0.74f, Rp = Ri * (0.25f + 0.45f * pupil_);
+    const int x0 = (int)floorf(cx - R - 3), x1 = (int)ceilf(cx + R + 3);
+    const int y0 = (int)floorf(cy - R - 3), y1 = (int)ceilf(cy + R + 3);
+    const float segs = 12, rot = iris_rot_ * side;
+    const float br = bright_;
+    for (int y = y0; y <= y1; y++) {
+        for (int x = x0; x <= x1; x++) {
+            const float dx = x - cx, dy = y - cy, r = sqrtf(dx * dx + dy * dy);
+            float v = 0;
+            const float hr = fabsf(r - (R + 1.5f));
+            if (hr < 1.0f) v = (1 - hr) * 80;
+            if (r > R) { if (v > 0) Put(x, y, v * br); continue; }
+            const float nx = dx / R, curve = 1 - 0.38f * nx * nx;
+            const float up = -R * ou * curve + tilt * dx * 0.38f - tilt_r_ * R * side;
+            const float lo = R * ol * curve - happy_ * R * 0.55f * (1 - nx * nx) - tilt_r_ * R * side;
+            const float du = dy - up, dl = lo - dy;
+            if (du < -0.9f || dl < -0.9f) {
+                if (y % 3 == 0) v = std::max(v, 22.0f);
+                if (v > 0) Put(x, y, v * br);
+                continue;
+            }
+            const float edge = std::min(fabsf(du), fabsf(dl));
+            if (edge < 0.9f) v = std::max(v, 240 * (1 - edge / 0.9f));
+            if (du >= 0 && dl >= 0) {
+                v = std::max(v, 10.0f);
+                const float ix = dx - gx, iy = dy - gy, ir = sqrtf(ix * ix + iy * iy);
+                if (ir < Ri + 1.5f) {
+                    const float d1 = fabsf(ir - Ri);
+                    if (d1 < 1.4f) v = std::max(v, 225 * (1 - d1 / 1.4f));
+                    if (ir > Rp + 2 && ir < Ri - 2) {
+                        const float ia = atan2f(iy, ix);
+                        const float f = fract((ia + rot) / (kPi * 2) * segs);
+                        const float glow = 70 + 110 * level_;
+                        if (f < 0.55f) v = std::max(v, glow * (0.75f + 0.25f * (ir - Rp) / (Ri - Rp)));
+                    }
+                    if (ir < Rp) v = 4;
+                    const float dp = fabsf(ir - Rp);
+                    if (dp < 1.1f) v = std::max(v, 200 * (1 - dp / 1.1f));
+                    const float glx = ix + Rp * 0.42f, gly = iy + Rp * 0.42f;
+                    if (glx * glx + gly * gly < 2.4f) v = 255;
+                }
+            }
+            if (v > 0) Put(x, y, v * br);
+        }
+    }
+}
+
+void Eyes::DrawScope() {
+    const int y0 = 86;
+    const float amp = 9;
+    for (int x = 18; x < LW - 18; x++) {
+        const float w = sinf((x - 18) / float(LW - 36) * kPi);
+        const int y = (int)lroundf(y0 + scope_[x] * amp * w);
+        Put(x, y, 150 * bright_);
+        const int yp = (int)lroundf(y0 + scope_[x - 1] * amp * w);
+        for (int k = std::min(y, yp) + 1; k < std::max(y, yp); k++) Put(x, k, 120 * bright_);
+    }
+}
+
+void Eyes::DrawText(const char32_t* s, int n, int x, int y, uint8_t v) {
+    for (int i = 0; i < n; i++) {
+        const uint8_t* g = Glyph(s[i]);
+        if (g) {
+            for (int r = 0; r < CV_FONT_H; r++) {
+                const uint8_t bits = g[r];
+                if (!bits) continue;
+                const int py = y + r;
+                if (py < 0 || py >= SH) continue;
+                for (int c = 0; c < CV_FONT_W; c++) {
+                    if (bits & (0x80 >> c)) {
+                        const int px = x + c;
+                        PutText(px, py, v);
+                    }
+                }
+            }
+        }
+        x += CV_FONT_W;
+    }
+}
+
+void Eyes::DrawHud() {
+    const uint8_t dim = 150, hi = 235;
+    DrawText(unit_, 6, 4, dim);
+    if (!clock_.empty()) DrawText(clock_.data(), clock_.size(), (SW - CV_FONT_W * (int)clock_.size()) / 2, 4, dim);
+    if (battery_ >= 0) {
+        std::u32string b;
+        b += charging_ ? U'+' : U' ';
+        int bars = (battery_ + 12) / 25;
+        for (int i = 0; i < 4; i++) b += i < bars ? U'█' : U'·';
+        b += U' ';
+        for (char c : std::to_string(battery_)) b += (char32_t)c;
+        b += U'%';
+        DrawText(b.data(), b.size(), SW - 6 - CV_FONT_W * (int)b.size(), 4, dim);
+    }
+    for (int x = 6; x < SW - 6; x += 3) PutText(x, 18, 90);
+    for (int x = 6; x < SW - 6; x += 3) PutText(x, 190, 90);
+
+    std::u32string status = U"> ";
+    if (notification_left_ > 0) {
+        status += notification_;
+    } else {
+        status += StatusText(state_);
+        if (state_ == EyeState::Thinking || state_ == EyeState::Connecting) {
+            int dots = (int)(t_ * 3) % 4;
+            for (int i = 0; i < dots; i++) status += U'.';
+        }
+    }
+    if (((int)(t_ * 2.5f)) & 1) status += U'█';
+    DrawText(status.data(), std::min<int>(status.size(), 28), 6, 194, hi);
+    DrawMessage(210, 2, false);
+}
+
+// Typewriter message, word-wrapped to 28 columns; shows the last `max_lines` lines.
+void Eyes::DrawMessage(int y0, int max_lines, bool cursor) {
+    const uint8_t dim = 150, hi = 235;
+    const int cols = 28;
+    std::u32string shown = message_.substr(0, (size_t)message_shown_);
+    if (role_ == Role::User && !shown.empty()) shown = U"> " + shown;
+    std::u32string lines[16];
+    int nlines = 0;
+    std::u32string cur, word;
+    auto flush_word = [&]() {
+        if (word.empty()) return;
+        if (!cur.empty() && cur.size() + 1 + word.size() > (size_t)cols) {
+            if (nlines < 16) lines[nlines++] = cur; else { for (int i = 1; i < 16; i++) lines[i - 1] = lines[i]; lines[15] = cur; }
+            cur.clear();
+        }
+        while (word.size() > (size_t)cols) {  // hard-break very long words
+            if (!cur.empty()) { lines[nlines < 16 ? nlines++ : 15] = cur; cur.clear(); }
+            lines[nlines < 16 ? nlines++ : 15] = word.substr(0, cols);
+            word = word.substr(cols);
+        }
+        if (!cur.empty()) cur += U' ';
+        cur += word;
+        word.clear();
+    };
+    for (char32_t c : shown) {
+        if (c == U' ' || c == U'\n' || c == U'\t') flush_word(); else word += c;
+    }
+    flush_word();
+    if (!cur.empty()) { if (nlines < 16) lines[nlines++] = cur; else { for (int i = 1; i < 16; i++) lines[i - 1] = lines[i]; lines[15] = cur; } }
+    if (cursor && ((int)(t_ * 2.5f)) & 1) {
+        if (nlines == 0) lines[nlines++] = U"";
+        lines[nlines - 1] += U'█';
+    }
+    const int first = std::max(0, nlines - max_lines);
+    for (int i = first; i < nlines; i++) {
+        DrawText(lines[i], 6, y0 + (i - first) * 13, role_ == Role::User ? dim : hi);
+    }
+}
+
+// ================= circuit-face style (port of proto buildCircuit & co.) =================
+void Eyes::SLine(int x0, int y0, int x1, int y1, uint8_t v) {
+    const int n = std::max({abs(x1 - x0), abs(y1 - y0), 1});
+    for (int i = 0; i <= n; i++) {
+        const int x = (int)lroundf(x0 + (x1 - x0) * (float)i / n), y = (int)lroundf(y0 + (y1 - y0) * (float)i / n);
+        if (x >= 0 && y >= 0 && x < LW && y < LH && v > circuit_[y * LW + x]) circuit_[y * LW + x] = v;
+    }
+}
+
+void Eyes::SRing(float cx, float cy, float r, uint8_t v) {
+    for (int y = (int)floorf(cy - r - 2); y <= cy + r + 2; y++) {
+        for (int x = (int)floorf(cx - r - 2); x <= cx + r + 2; x++) {
+            const float d = fabsf(sqrtf((x - cx) * (x - cx) + (y - cy) * (y - cy)) - r);
+            if (d < 0.8f && x >= 0 && y >= 0 && x < LW && y < LH) {
+                const uint8_t w = (uint8_t)(v * (1 - d / 0.8f));
+                if (w > circuit_[y * LW + x]) circuit_[y * LW + x] = w;
+            }
+        }
+    }
+}
+
+void Eyes::BuildCircuit() {
+    circuit_ = (uint8_t*)heap_caps_calloc(LW * LH, 1, MALLOC_CAP_SPIRAM);
+    if (!circuit_) return;
+    const uint8_t v = 75;
+    auto pad = [this](float x, float y) { SRing(x, y, 1.6f, 110); };
+    const int R = 16;
+    const int eyes[2][2] = {{34, 44}, {86, 44}};
+    for (auto& e : eyes) {
+        const int cx = e[0], cy = e[1], s = cx < 60 ? -1 : 1;
+        SRing(cx, cy, R + 4, 90);
+        SRing(cx, cy, R + 6.5f, 40);
+        SLine(cx, cy - R - 6, cx, 18, v); SLine(cx, 18, 60, 18, v);
+        const int ox = cx + s * (R + 6);
+        SLine(ox, cy - 6, cx + s * 27, cy - 6, v); SLine(cx + s * 27, cy - 6, cx + s * 27, 22, v); pad(cx + s * 27, 21);
+        SLine(ox, cy + 5, cx + s * 30, cy + 5, v); SLine(cx + s * 30, cy + 5, cx + s * 30, 58, v); pad(cx + s * 30, 59);
+        SLine(cx + s * 14, cy + R + 2, cx + s * 14, 64, v); SLine(cx + s * 14, 64, cx + s * 22, 64, v); pad(cx + s * 23, 64);
+        for (int k = 0; k < 4; k++) {
+            const float a = k / 4.0f * kPi * 2 + 0.6f;
+            pad(cx + cosf(a) * (R + 9), cy + sinf(a) * (R + 9));
+        }
+    }
+    for (int x = 55; x <= 65; x++) { circuit_[16 * LW + x] = 110; circuit_[20 * LW + x] = 110; }
+    SLine(55, 16, 55, 20, 110); SLine(65, 16, 65, 20, 110);
+    SLine(57, 20, 57, 58, v); SLine(63, 20, 63, 58, v);
+    SLine(57, 58, 53, 62, v); SLine(63, 58, 67, 62, v); SLine(53, 62, 67, 62, v);
+    pad(52, 62); pad(68, 62);
+    SLine(22, 70, 22, 84, v); SLine(22, 70, 26, 70, v); SLine(22, 84, 26, 84, v);
+    SLine(98, 70, 98, 84, v); SLine(94, 70, 98, 70, v); SLine(94, 84, 98, 84, v);
+}
+
+void Eyes::DrawEyeCircuit(float cx, float cy, float R, int side) {
+    const float gx = (gx_ + mx_) * R * 0.32f, gy = (gy_ + my_) * R * 0.28f;
+    const float b = blink_, tilt = tilt_ * side;
+    const float ou = lerpf(open_u_, -open_l_ * 0.85f, b) * 1.1f, ol = open_l_ * (1 - 0.25f * b) * 1.25f;
+    const float Rc = R * (0.2f + 0.16f * pupil_);
+    const float rot = iris_rot_ * side, br = bright_;
+    for (int y = (int)floorf(cy - R - 2); y <= cy + R + 2; y++) {
+        for (int x = (int)floorf(cx - R - 2); x <= cx + R + 2; x++) {
+            const float dx = x - cx, dy = y - cy, r = sqrtf(dx * dx + dy * dy);
+            if (r > R + 1.5f) continue;
+            const float nx = clampf(dx / R, -1, 1), curve = 1 - 0.3f * nx * nx;
+            const float up = -R * ou * curve + tilt * dx * 0.38f - tilt_r_ * R * side;
+            const float lo = R * ol * curve - happy_ * R * 0.6f * (1 - nx * nx) - tilt_r_ * R * side;
+            const float du = dy - up, dl = lo - dy;
+            float v = 0;
+            if (du < -0.9f || dl < -0.9f) {
+                if (y % 2 == 0 && r < R) Put(x, y, 26 * br);
+                continue;
+            }
+            const float edge = std::min(fabsf(du), fabsf(dl));
+            if (edge < 0.9f && r < R + 0.5f) v = 230 * (1 - edge / 0.9f);
+            if (du >= 0 && dl >= 0) {
+                if (r > R - 3 && r < R) {
+                    const float f = fract((atan2f(dy, dx) + rot) / (kPi * 2) * 3);
+                    if (f < 0.62f) v = std::max(v, 150 + 80 * level_);
+                }
+                const float d2 = fabsf(r - R * 0.72f);
+                if (d2 < 0.8f) v = std::max(v, 140.0f);
+                const float ix = dx - gx, iy = dy - gy, ir = sqrtf(ix * ix + iy * iy);
+                if (ir < Rc + 3.2f) {
+                    if (ir > Rc && ir < Rc + 1.6f) v = 6;
+                    const float dr = fabsf(ir - (Rc + 2.4f));
+                    if (dr < 0.9f) v = std::max(v, 200.0f);
+                    if (ir <= Rc) v = 215 + 40 * (1 - ir / Rc);
+                }
+                if (r < R - 3 && v < 12) v = 12;
+            }
+            if (v > 0) Put(x, y, v * br);
+        }
+    }
+}
+
+void Eyes::DrawMouth() {
+    const int y0 = 77, x0 = 27, x1 = 93;
+    const float talk = (state_ == EyeState::Speaking || state_ == EyeState::Listening) ? level_ : 0;
+    for (int x = x0; x <= x1; x++) {
+        // sinf(pi) is a hair below zero; powf(negative, 1.3) = NaN -> clamp first.
+        const float env = powf(std::max(0.0f, sinf(kPi * (x - x0) / (float)(x1 - x0))), 1.3f);
+        const float idle = 0.6f + 0.4f * sinf(t_ * 3 + x * 0.4f);
+        const float hf = env * (talk * 9 * (0.35f + 0.65f * Rnd(0, 1)) + idle * 0.8f);
+        const int h = std::isfinite(hf) ? std::clamp((int)lroundf(hf), 0, 12) : 0;
+        for (int k = -h; k <= h; k++) Put(x, y0 + k, (225 - abs(k) * 10) * bright_);
+        Put(x, y0, 120 * bright_);
+    }
+}
+
+void Eyes::DrawSpectrum() {
+    const float talk = (state_ == EyeState::Speaking || state_ == EyeState::Listening) ? level_ : 0.05f;
+    for (int i = 0; i < 6; i++) {
+        const float target = talk * (1 - i / 9.0f) * (0.3f + 0.7f * Rnd(0, 1)) + 0.06f;
+        spec_[i] += (target - spec_[i]) * 0.35f;
+        const int h = std::clamp((int)lroundf(spec_[i] * 18), 0, 20), x = 3 + i * 3;
+        for (int k = 0; k < h; k++) { Put(x, 87 - k, 170 * bright_); Put(x + 1, 87 - k, 170 * bright_); }
+    }
+    for (int x = 2; x < 20; x++) Put(x, 88, 90 * bright_);
+}
+
+static std::u32string U32(const char* s) {
+    std::u32string r;
+    while (*s) r += (char32_t)(unsigned char)*s++;
+    return r;
+}
+
+void Eyes::DrawHudCircuit() {
+    const uint8_t dim = 150, hi = 235;
+    static const char* kState[] = {"IDLE", "LISTENING", "PROCESSING", "SPEAKING", "LINKING", "NO SIGNAL", "STANDBY"};
+    static const char* kEmo[] = {"NEUTRAL", "CONFIDENT", "SUBDUED", "HOSTILE", "ALERT", "ANALYTIC", "LOW POWER"};
+    {
+        std::u32string head = header_ + U": " + unit_;
+        if (head.size() > 28) head.resize(28);
+        DrawText(head, 6, 2, hi);
+    }
+    std::u32string st;
+    if (notification_left_ > 0) {
+        st = notification_;
+    } else {
+        st = U32("STATUS: ") + U32(kState[(int)state_]);
+        if (state_ == EyeState::Thinking || state_ == EyeState::Connecting) {
+            for (int i = 0, n = (int)(t_ * 3) % 4; i < n; i++) st += U'.';
+        }
+    }
+    if (st.size() > 23) st.resize(23);
+    DrawText(st, 6, 14, dim);
+    if (battery_ >= 0) {
+        std::u32string b = charging_ ? U"+" : U"";
+        b += U32(std::to_string(battery_).c_str()) + U"%";
+        DrawText(b, SW - 6 - CV_FONT_W * (int)b.size(), 14, dim);
+    }
+    if (hex_t_ < 0 || t_ - hex_t_ > 0.35f) {
+        hex_t_ = t_;
+        for (auto& h : hex_) {
+            char buf[8];
+            snprintf(buf, sizeof(buf), "%04X", (unsigned)(Rand() & 0xffff));
+            h = U32(buf);
+        }
+    }
+    DrawText(U"DIAG", 198, 124, dim);
+    for (int i = 0; i < 3; i++) DrawText(hex_[i], 198, 137 + i * 12, state_ == EyeState::Thinking ? hi : 110);
+    DrawText(U32("EMOTIVE: ") + U32(kEmo[(int)emotion_]), 6, 177, dim);
+    DrawText(state_ == EyeState::Error ? U"NET:LOST" : U"NET:OK", SW - 6 - CV_FONT_W * (state_ == EyeState::Error ? 8 : 6), 177, dim);
+    for (int x = 6; x < SW - 6; x += 3) PutText(x, 190, 90);
+    DrawMessage(195, 3, true);
+}
+
+void Eyes::Render(uint16_t* out) {
+    if (!ok() || !out) return;
+    const Fx fx = has_fx_ ? skin_fx_ : DefaultFx(style_);
+    const int decay = (int)(fx.decay * 256);
+    if (decay <= 0) memset(phos_, 0, LW * LH);
+    else for (int i = 0; i < LW * LH; i++) phos_[i] = (uint8_t)((phos_[i] * decay) >> 8);
+    if (bg_) {   // skin background: a dim, steady phosphor image behind everything
+        const int k = (int)(bright_ * 256);
+        for (int i = 0; i < LW * LH; i++) {
+            const uint8_t c = (uint8_t)((bg_[i] * k) >> 8);
+            if (c > phos_[i]) phos_[i] = c;
+        }
+    }
+    switch (style_) {
+        case kPixel: DrawPixel(); break;
+        case kHolo: DrawHoloCore(); break;
+        case kOrb: DrawOrb(); break;
+        case kPet: DrawPet(); break;
+        case kMinimal: DrawMinimal(); break;
+        case kRealEye: DrawRealEye(); break;
+        default: break;
+    }
+    if (style_ == kCircuit) {
+        if (!circuit_) BuildCircuit();
+        if (circuit_) {
+            const int k = (int)(bright_ * 256);
+            for (int i = 0; i < LW * LH; i++) {
+                const uint8_t c = (uint8_t)((circuit_[i] * k) >> 8);
+                if (c > phos_[i]) phos_[i] = c;
+            }
+        }
+        if (skin_eyes_) {
+            DrawEyeCircuit(sk_lx_, sk_ly_, sk_r_, -1);
+            DrawEyeCircuit(sk_rx_, sk_ry_, sk_r_, 1);
+        } else {
+            DrawEyeCircuit(34, 44, 16, -1);
+            DrawEyeCircuit(86, 44, 16, 1);
+        }
+        DrawMouth();
+        DrawSpectrum();
+    } else if (style_ == kClassic) {
+        if (skin_eyes_) {
+            DrawEye(sk_lx_, sk_ly_, sk_r_, -1);
+            DrawEye(sk_rx_, sk_ry_, sk_r_, 1);
+        } else {
+            DrawEye(33, 50, 22, -1);
+            DrawEye(87, 50, 22, 1);
+        }
+        DrawScope();
+    }
+
+    memset(row_shift_, 0, sizeof(row_shift_));
+    if (glitch_ > 0) {
+        int bands = 2 + Rand() % 3;
+        for (int k = 0; k < bands; k++) {
+            int y = Rand() % SH, h = 2 + Rand() % 10, sh = (int)(Rand() % 15) - 7;
+            for (int j = y; j < std::min(SH, y + h); j++) row_shift_[j] = (int8_t)sh;
+        }
+    }
+    Composite(out, fx);
+    // HUD text is drawn last, straight into the frame
+    switch (fx.hud) {
+        case 1: DrawHudCircuit(); break;
+        case 2: DrawHudPixel(); break;
+        case 3: DrawHudHolo(); break;
+        case 4: DrawHudMinimal(); break;
+        default: DrawHud(); break;
+    }
+    out_ = nullptr;
+}
+
+Fx Eyes::DefaultFx(int style) {
+    Fx f;
+    switch (style) {
+        case kCircuit: f.hud = 1; break;
+        case kPixel: f = {0.82f, 0, false, true, false, 0.0f, 2}; break;
+        case kHolo: f = {0.8f, 3, true, true, true, 0.35f, 3}; break;
+        case kOrb: f = {1.0f, 0, false, false, true, 0.55f, 4}; break;
+        case kPet: f = {1.0f, 0, false, false, true, 0.0f, 4}; break;
+        case kMinimal: f = {1.0f, 0, false, false, true, 0.3f, 4}; break;
+        case kRealEye: f = {1.0f, 0, false, true, true, 0.0f, 4}; break;
+        default: break;   // classic CRT
+    }
+    return f;
+}
+
+void Eyes::Composite(uint16_t* out, const Fx& fx) {
+    const uint16_t* pal = state_ == EyeState::Error ? pal_[2] : has_custom_pal_ ? custom_pal_ : pal_[palette_];
+    cur_pal_ = pal;
+    out_ = out;
+    const int flicker = fx.flicker ? 247 + (int)(Rand() % 9) : 256;   // ~0.965..1.0 in /256
+    const int scan = (int)(fx.scan * 256);
+    for (int Y = 0; Y < SH; Y++) {
+        int k = fx.vign ? rowf_[Y] : 255;
+        if (Y & 1) k = k * scan >> 8;
+        rowk_[Y] = k * flicker >> 8;
+    }
+    for (int X = 0; X < SW; X++) colk_[X] = fx.vign ? colf_[X] : 255;
+    const int noise_mask = fx.noise >= 7 ? 7 : fx.noise >= 3 ? 3 : fx.noise >= 1 ? 1 : 0;
+    for (int Y = 0; Y < SH; Y++) {
+        const int sh = row_shift_[Y], rk = rowk_[Y];
+        uint16_t* orow = out + Y * SW;
+        uint32_t noise = Rand();
+        if (fx.smooth) {
+            // Exact 2x bilinear: weights are always 1/4 and 3/4. Blend the two source rows once,
+            // then each output pixel is a fixed mix of two neighbours of that blended row.
+            const int k = Y >> 1;
+            const int ya = (Y & 1) ? k : (k > 0 ? k - 1 : 0);       // row weighted 1/4
+            const int yb = (Y & 1) ? (k + 1 < LH ? k + 1 : k) : k;  // row weighted 3/4 (even) / ... (odd)
+            const uint8_t* ra = phos_ + ya * LW;
+            const uint8_t* rb = phos_ + yb * LW;
+            uint8_t row[LW + 2];
+            if (Y & 1) { for (int i = 0; i < LW; i++) row[i + 1] = (uint8_t)((ra[i] * 3 + rb[i]) >> 2); }
+            else       { for (int i = 0; i < LW; i++) row[i + 1] = (uint8_t)((ra[i] + rb[i] * 3) >> 2); }
+            row[0] = row[1];
+            row[LW + 1] = row[LW];
+            for (int X = 0; X < SW; X++) {
+                int sx = X + sh;
+                sx = sx < 0 ? 0 : (sx >= SW ? SW - 1 : sx);
+                const int j = (sx >> 1) + 1;
+                int v = (sx & 1) ? (row[j] * 3 + row[j + 1]) >> 2 : (row[j - 1] + row[j] * 3) >> 2;
+                v = ((v * colk_[X]) >> 8) * rk >> 8;
+                if (noise_mask) {
+                    if ((X & 7) == 0) noise = Rand();
+                    v += (int)(noise & noise_mask);
+                    noise >>= 3;
+                }
+                orow[X] = pal[v > 255 ? 255 : v];
+            }
+        } else {
+            const uint8_t* prow = phos_ + (Y >> 1) * LW;
+            for (int X = 0; X < SW; X++) {
+                int sx = X + sh;
+                sx = sx < 0 ? 0 : (sx >= SW ? SW - 1 : sx);
+                int v = ((prow[sx >> 1] * colk_[X]) >> 8) * rk >> 8;
+                if (noise_mask) {
+                    if ((X & 7) == 0) noise = Rand();
+                    v += (int)(noise & noise_mask);
+                    noise >>= 3;
+                }
+                orow[X] = pal[v > 255 ? 255 : v];
+            }
+        }
+    }
+}
+
