+#include "cv_io.h"
+#include "cv_eyes_display.h"
+#include "mcp_server.h"
+#include "application.h"
+#include "assets/lang_config.h"
+#include "board.h"
+#include "cv_hw.h"
+
+#include <cJSON.h>
+#include <cstring>
+#include <vector>
+
+#include <driver/gpio.h>
+#include <driver/ledc.h>
+#include <soc/soc_caps.h>
+#if SOC_TOUCH_SENSOR_SUPPORTED && SOC_TOUCH_SENSOR_VERSION >= 2
+#include <driver/touch_sens.h>
+#define CV_HAS_TOUCH 1
+#else
+#define CV_HAS_TOUCH 0
+#endif
+#include <esp_adc/adc_oneshot.h>
+#include <esp_log.h>
+#include <esp_timer.h>
+#include <esp_heap_caps.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/task.h>
+
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <cstdio>
+#include <mutex>
+
+#define TAG "CvIo"
+
+namespace cv {
+namespace {
+
+CvEyesDisplay* g_display = nullptr;   // animated eyes, may be null (OLED / no screen)
+std::mutex g_mu;
+
+// ---------------- pins ----------------
+enum class Mode { Free, Out, In, Pwm, Servo, Antenna };
+struct PinState { int pin; Mode mode; int channel; };
+std::vector<PinState> g_pins;
+
+// GPIOs that are never offered: flash / PSRAM / USB lines of the chip.
+bool ReservedPin(int pin) {
+#if CONFIG_IDF_TARGET_ESP32S3
+    // 26-32: SPI flash; 33-37: octal PSRAM (free on modules with quad PSRAM or none); 19/20: USB
+#ifdef CONFIG_SPIRAM_MODE_OCT
+    const bool octal_psram = heap_caps_get_total_size(MALLOC_CAP_SPIRAM) > 0;
+#else
+    const bool octal_psram = false;
+#endif
+    return (pin >= 26 && pin <= 32) || (octal_psram && pin >= 33 && pin <= 37) || pin == 19 || pin == 20;
+#elif CONFIG_IDF_TARGET_ESP32C3
+    return pin == 18 || pin == 19;   // USB; GPIO12-17 belong to external flash only on chips without in-package flash
+#else
+    return false;
+#endif
+}
+
+void BuildUserPins() {
+    g_pins.clear();
+    for (int pin = 0; pin < SOC_GPIO_PIN_COUNT; pin++) {
+        if (!GPIO_IS_VALID_OUTPUT_GPIO(pin) || ReservedPin(pin) || HwPinTaken(pin)) continue;
+        g_pins.push_back({pin, Mode::Free, -1});
+    }
+}
+bool g_servo_timer = false;
+bool g_pwm_timer = false;
+uint32_t g_pwm_freq = 0;
+adc_oneshot_unit_handle_t g_adc = nullptr;
+
+PinState* Find(int pin) {
+    for (auto& p : g_pins) if (p.pin == pin) return &p;
+    return nullptr;
+}
+
+std::string PinError(int pin) {
+    if (pin == 2) return "GPIO2 is the board's power latch: driving it switches the device off. Use another pin.";
+    std::string s = "GPIO" + std::to_string(pin) + " is not available. Free pins:";
+    for (auto& st : g_pins) {
+        if (st.mode != Mode::Antenna) s += " " + std::to_string(st.pin);
+    }
+    return s;
+}
+
+PinState* Claim(int pin) {
+    PinState* p = Find(pin);
+    if (!p) throw std::runtime_error(PinError(pin));
+    if (p->mode == Mode::Antenna) throw std::runtime_error("GPIO" + std::to_string(pin) + " is assigned to an input or output in the hardware profile.");
+    return p;
+}
+
+void Release(PinState* p) {
+    if (p->mode == Mode::Pwm || p->mode == Mode::Servo) {
+        ledc_stop(LEDC_LOW_SPEED_MODE, (ledc_channel_t)p->channel, 0);
+    }
+    if (p->mode != Mode::Free) gpio_reset_pin((gpio_num_t)p->pin);
+    p->mode = Mode::Free;
+    p->channel = -1;
+}
+
+int AllocChannel(PinState* self) {
+    // LEDC channel 0 belongs to the backlight.
+    for (int ch = 1; ch < 8; ch++) {
+        bool used = false;
+        for (auto& p : g_pins) if (&p != self && p.channel == ch) used = true;
+        if (!used) return ch;
+    }
+    throw std::runtime_error("All 7 PWM/servo channels are busy; release a pin first.");
+}
+
+void SetupLedc(PinState* p, Mode mode, ledc_timer_t timer, uint32_t duty) {
+    if (p->mode != mode) {
+        Release(p);
+        p->channel = AllocChannel(p);
+        ledc_channel_config_t ch = {};
+        ch.gpio_num = p->pin;
+        ch.speed_mode = LEDC_LOW_SPEED_MODE;
+        ch.channel = (ledc_channel_t)p->channel;
+        ch.timer_sel = timer;
+        ch.duty = duty;
+        ESP_ERROR_CHECK(ledc_channel_config(&ch));
+        p->mode = mode;
+    } else {
+        ledc_set_duty(LEDC_LOW_SPEED_MODE, (ledc_channel_t)p->channel, duty);
+        ledc_update_duty(LEDC_LOW_SPEED_MODE, (ledc_channel_t)p->channel);
+    }
+}
+
+ReturnValue Servo(int pin, int angle, int min_us, int max_us) {
+    std::lock_guard<std::mutex> lock(g_mu);
+    PinState* p = Claim(pin);
+    if (!g_servo_timer) {
+        ledc_timer_config_t t = {};
+        t.speed_mode = LEDC_LOW_SPEED_MODE;
+        t.duty_resolution = LEDC_TIMER_14_BIT;
+        t.timer_num = LEDC_TIMER_1;
+        t.freq_hz = 50;
+        t.clk_cfg = LEDC_AUTO_CLK;
+        ESP_ERROR_CHECK(ledc_timer_config(&t));
+        g_servo_timer = true;
+    }
+    angle = std::clamp(angle, 0, 180);
+    const float us = min_us + (max_us - min_us) * angle / 180.0f;
+    const uint32_t duty = (uint32_t)(us / 20000.0f * 16383);
+    SetupLedc(p, Mode::Servo, LEDC_TIMER_1, duty);
+    return "servo on GPIO" + std::to_string(pin) + " -> " + std::to_string(angle) + " deg";
+}
+
+ReturnValue Pwm(int pin, int freq, int duty_percent) {
+    std::lock_guard<std::mutex> lock(g_mu);
+    PinState* p = Claim(pin);
+    freq = std::clamp(freq, 1, 40000);
+    if (!g_pwm_timer || g_pwm_freq != (uint32_t)freq) {
+        ledc_timer_config_t t = {};
+        t.speed_mode = LEDC_LOW_SPEED_MODE;
+        t.duty_resolution = LEDC_TIMER_10_BIT;
+        t.timer_num = LEDC_TIMER_2;
+        t.freq_hz = (uint32_t)freq;
+        t.clk_cfg = LEDC_AUTO_CLK;
+        if (ledc_timer_config(&t) != ESP_OK) throw std::runtime_error("unsupported PWM frequency");
+        g_pwm_timer = true;
+        g_pwm_freq = freq;
+    }
+    const uint32_t duty = (uint32_t)(std::clamp(duty_percent, 0, 100) * 1023 / 100);
+    SetupLedc(p, Mode::Pwm, LEDC_TIMER_2, duty);
+    return "PWM on GPIO" + std::to_string(pin) + ": " + std::to_string(freq) + " Hz, " +
+           std::to_string(duty_percent) + "% (all PWM pins share one frequency)";
+}
+
+ReturnValue Write(int pin, int level) {
+    std::lock_guard<std::mutex> lock(g_mu);
+    PinState* p = Claim(pin);
+    if (p->mode != Mode::Out) {
+        Release(p);
+        gpio_config_t c = {};
+        c.pin_bit_mask = 1ULL << pin;
+        c.mode = GPIO_MODE_INPUT_OUTPUT;   // readable back
+        ESP_ERROR_CHECK(gpio_config(&c));
+        p->mode = Mode::Out;
+    }
+    gpio_set_level((gpio_num_t)pin, level ? 1 : 0);
+    return true;
+}
+
+ReturnValue Read(int pin, const std::string& pull) {
+    std::lock_guard<std::mutex> lock(g_mu);
+    PinState* p = Claim(pin);
+    if (p->mode != Mode::Out) {
+        Release(p);
+        gpio_config_t c = {};
+        c.pin_bit_mask = 1ULL << pin;
+        c.mode = GPIO_MODE_INPUT;
+        c.pull_up_en = pull == "up" ? GPIO_PULLUP_ENABLE : GPIO_PULLUP_DISABLE;
+        c.pull_down_en = pull == "down" ? GPIO_PULLDOWN_ENABLE : GPIO_PULLDOWN_DISABLE;
+        ESP_ERROR_CHECK(gpio_config(&c));
+        p->mode = Mode::In;
+    }
+    return gpio_get_level((gpio_num_t)pin);
+}
+
+ReturnValue AnalogRead(int pin) {
+    std::lock_guard<std::mutex> lock(g_mu);
+    PinState* p = Claim(pin);
+    adc_unit_t unit;
+    adc_channel_t channel;
+    if (adc_oneshot_io_to_channel(pin, &unit, &channel) != ESP_OK || unit != ADC_UNIT_1)
+        throw std::runtime_error("GPIO" + std::to_string(pin) + " has no ADC1 channel on this chip.");
+    if (!g_adc) {
+        adc_oneshot_unit_init_cfg_t u = {};
+        u.unit_id = ADC_UNIT_1;
+        ESP_ERROR_CHECK(adc_oneshot_new_unit(&u, &g_adc));
+    }
+    Release(p);
+    adc_oneshot_chan_cfg_t c = {};
+    c.atten = ADC_ATTEN_DB_12;
+    c.bitwidth = ADC_BITWIDTH_12;
+    ESP_ERROR_CHECK(adc_oneshot_config_channel(g_adc, channel, &c));
+    int raw = 0;
+    ESP_ERROR_CHECK(adc_oneshot_read(g_adc, channel, &raw));
+    p->mode = Mode::In;
+    char buf[96];
+    snprintf(buf, sizeof(buf), "{\"raw\":%d,\"max\":4095,\"approx_volts\":%.2f}", raw, raw * 3.1f / 4095.0f);
+    return std::string(buf);
+}
+
+ReturnValue ListPins() {
+    std::lock_guard<std::mutex> lock(g_mu);
+    static const char* kModes[] = {"free", "output", "input", "pwm", "servo", "antenna"};
+    std::string s = "{\"pins\":[";
+    for (size_t i = 0; i < g_pins.size(); i++) {
+        if (i) s += ",";
+        s += "{\"gpio\":" + std::to_string(g_pins[i].pin) + ",\"mode\":\"" + kModes[(int)g_pins[i].mode] + "\"}";
+    }
+    s += "],\"note\":\"3.3V logic, max ~20 mA per pin; "
+         "power servos from 5V, not from a GPIO.\"}";
+    return s;
+}
+
+// ---------------- inputs (touch antennae / buttons) and outputs ----------------
+// Pins, types and actions come from the hardware profile (cv_hw.h); actions can change at runtime.
+constexpr int kMaxInputs = 8;
+constexpr int64_t kHoldUs = 700 * 1000;      // press longer than this = hold
+constexpr int64_t kDoubleUs = 350 * 1000;    // second tap within this = double tap
+
+struct InputRt {
+    int pin = -1;
+    bool touch = true;
+#if CV_HAS_TOUCH
+    touch_channel_handle_t chan = nullptr;
+#endif
+    float base = 0;
+    std::atomic<uint32_t> raw{0};
+    std::atomic<bool> pressed{false};
+    int64_t down_us = 0, last_up_us = 0;
+    bool hold_fired = false, tap_pending = false;
+};
+
+#if CV_HAS_TOUCH
+touch_sensor_handle_t g_touch = nullptr;
+#endif
+InputRt g_in[kMaxInputs];
+int g_in_count = 0;
+std::atomic<int> g_touches{0};
+std::atomic<int64_t> g_last_touch_us{0};
+std::atomic<float> g_affection{0.5f};   // 0 = lonely, 1 = blissful
+Display* g_screen = nullptr;            // any screen (notifications)
+bool g_listen_held = false;
+
+std::vector<HwOutput> g_outputs;
+
+void OutputSet(const HwOutput& o, bool on) {
+    gpio_set_level((gpio_num_t)o.pin, on != o.active_low);
+}
+
+void PulseTask(void* arg) {
+    int ms = (int)(intptr_t)arg;
+    for (auto& o : g_outputs) if (o.type == "vibration") OutputSet(o, true);
+    vTaskDelay(pdMS_TO_TICKS(ms));
+    for (auto& o : g_outputs) if (o.type == "vibration") OutputSet(o, false);
+    vTaskDelete(nullptr);
+}
+
+void Vibrate(int ms) {
+    bool any = false;
+    for (auto& o : g_outputs) any |= o.type == "vibration";
+    if (any) xTaskCreate(PulseTask, "vibe", 2048, (void*)(intptr_t)std::clamp(ms, 20, 3000), 3, nullptr);
+}
+
+void Affection() {
+    g_touches++;
+    g_last_touch_us = esp_timer_get_time();
+    g_affection = std::min(1.0f, g_affection.load() + 0.2f);
+    ESP_LOGI(TAG, "affection %.2f", g_affection.load());
+    if (g_display) g_display->ShowEyeEmotion("happy", 4);
+    if (g_screen) {
+        static const char* kPurr[] = {"МРРР...", "ЕЩЁ!", "ПРИЯТНО", "ХОРОШО..."};
+        g_screen->ShowNotification(kPurr[g_touches % 4], 2500);
+    }
+    auto& app = Application::GetInstance();
+    if (app.GetDeviceState() == kDeviceStateIdle) app.PlaySound(Lang::Sounds::OGG_POPUP);
+}
+
+void SendEvent(const std::string& input, const char* gesture) {
+    auto& app = Application::GetInstance();
+    if (app.GetDeviceState() == kDeviceStateIdle) {
+        // Opens the channel; the server recognises the "cv_event:" prefix and lets the assistant react.
+        app.WakeWordInvoke("cv_event:" + input + ":" + gesture);
+        return;
+    }
+    cJSON* root = cJSON_CreateObject();
+    cJSON_AddStringToObject(root, "jsonrpc", "2.0");
+    cJSON_AddStringToObject(root, "method", "notifications/cv_event");
+    cJSON* params = cJSON_AddObjectToObject(root, "params");
+    cJSON_AddStringToObject(params, "input", input.c_str());
+    cJSON_AddStringToObject(params, "gesture", gesture);
+    char* s = cJSON_PrintUnformatted(root);
+    app.SendMcpMessage(s);
+    cJSON_free(s);
+    cJSON_Delete(root);
+}
+
+// Runs one comma-separated action list. `phase`: 0 = gesture recognised, 1 = hold released.
+void RunActions(const HwInput& in, const std::string& list, const char* gesture, int phase) {
+    auto& app = Application::GetInstance();
+    size_t pos = 0;
+    while (pos <= list.size()) {
+        size_t comma = list.find(',', pos);
+        std::string a = list.substr(pos, comma == std::string::npos ? std::string::npos : comma - pos);
+        pos = comma == std::string::npos ? list.size() + 1 : comma + 1;
+        if (a.empty() || a == "none") continue;
+        if (phase == 1) {   // hold released: only push-to-talk cares
+            if (a == "listen" && g_listen_held) {
+                g_listen_held = false;
+                app.Schedule([&app]() { app.StopListening(); });
+            }
+            continue;
+        }
+        ESP_LOGI(TAG, "%s %s -> %s", in.name.c_str(), gesture, a.c_str());
+        if (a == "affection") Affection();
+        else if (a == "wake") app.Schedule([&app]() { app.ToggleChatState(); });
+        else if (a == "listen") {
+            if (strcmp(gesture, "hold") == 0) {
+                g_listen_held = true;
+                app.Schedule([&app]() { app.StartListening(); });
+            } else {
+                app.Schedule([&app]() { app.ToggleChatState(); });
+            }
+        }
+        else if (a == "stop") app.Schedule([&app]() { app.AbortSpeaking(kAbortReasonNone); });
+        else if (a == "event") SendEvent(in.name, gesture);
+        else if (a == "vibrate") Vibrate(strcmp(gesture, "hold") == 0 ? 600 : 200);
+        else if (a == "volume_up" || a == "volume_down") {
+            auto codec = Board::GetInstance().GetAudioCodec();
+            int v = std::clamp(codec->output_volume() + (a == "volume_up" ? 10 : -10), 0, 100);
+            codec->SetOutputVolume(v);
+            if (g_screen) g_screen->ShowNotification(Lang::Strings::VOLUME + std::to_string(v / 10));
+        }
+        else if (a.rfind("emotion:", 0) == 0) {
+            if (g_display) g_display->ShowEyeEmotion(a.substr(8), 5);
+            else if (g_screen) g_screen->SetEmotion(a.substr(8).c_str());
+        }
+        else if (a.rfind("sound:", 0) == 0) {
+            const std::string s = a.substr(6);
+            if (s == "success") app.PlaySound(Lang::Sounds::OGG_SUCCESS);
+            else if (s == "vibration") app.PlaySound(Lang::Sounds::OGG_VIBRATION);
+            else if (s == "exclamation") app.PlaySound(Lang::Sounds::OGG_EXCLAMATION);
+            else app.PlaySound(Lang::Sounds::OGG_POPUP);
+        }
+    }
+}
+
+void Gesture(int idx, const char* gesture, int phase = 0) {
+    auto inputs = HwInputsSnapshot();
+    if (idx >= (int)inputs.size()) return;
+    const HwInput& in = inputs[idx];
+    const std::string& list = strcmp(gesture, "tap") == 0 ? in.tap : strcmp(gesture, "double") == 0 ? in.dbl : in.hold;
+    RunActions(in, list, gesture, phase);
+}
+
+bool InputHasAffection(int idx) {
+    auto inputs = HwInputsSnapshot();
+    if (idx >= (int)inputs.size()) return false;
+    auto& in = inputs[idx];
+    return (in.tap + in.dbl + in.hold).find("affection") != std::string::npos;
+}
+
+void InputTask(void*) {
+    vTaskDelay(pdMS_TO_TICKS(1500));   // settle, then take touch baselines
+    for (int i = 0; i < g_in_count; i++) {
+        if (!g_in[i].touch) continue;
+        uint32_t v = 0;
+#if CV_HAS_TOUCH
+        touch_channel_read_data(g_in[i].chan, TOUCH_CHAN_DATA_TYPE_SMOOTH, &v);
+#endif
+        g_in[i].base = v;
+    }
+    int64_t last_crave = esp_timer_get_time();
+    while (true) {
+        vTaskDelay(pdMS_TO_TICKS(40));
+        const int64_t now = esp_timer_get_time();
+        auto inputs = HwInputsSnapshot();
+        bool stroking = false;
+        for (int i = 0; i < g_in_count && i < (int)inputs.size(); i++) {
+            auto& r = g_in[i];
+            bool on;
+            if (r.touch) {
+                uint32_t v = 0;
+#if CV_HAS_TOUCH
+                if (touch_channel_read_data(r.chan, TOUCH_CHAN_DATA_TYPE_SMOOTH, &v) != ESP_OK) continue;
+#else
+                continue;
+#endif
+                r.raw = v;
+                const float k = inputs[i].sensitivity / 100.0f;
+                on = r.pressed ? v > r.base * (1 + k * 0.5f) : v > r.base * (1 + k);
+                if (!on && !r.pressed) r.base += (v - r.base) * 0.01f;   // follow slow drift
+            } else {
+                on = gpio_get_level((gpio_num_t)r.pin) == 0;               // buttons: active low
+            }
+            if (on && !r.pressed) {                                        // press
+                r.pressed = true;
+                r.down_us = now;
+                r.hold_fired = false;
+            } else if (on && r.pressed && !r.hold_fired && now - r.down_us > kHoldUs) {
+                r.hold_fired = true;                                       // hold recognised while held
+                r.tap_pending = false;
+                Gesture(i, "hold");
+            } else if (!on && r.pressed) {                                 // release
+                r.pressed = false;
+                if (r.hold_fired) {
+                    Gesture(i, "hold", 1);
+                } else if (r.tap_pending && now - r.last_up_us < kDoubleUs) {
+                    r.tap_pending = false;
+                    Gesture(i, "double");
+                } else {
+                    r.tap_pending = true;
+                    r.last_up_us = now;
+                }
+            }
+            if (r.tap_pending && !r.pressed && now - r.last_up_us >= kDoubleUs) {
+                r.tap_pending = false;
+                Gesture(i, "tap");
+            }
+            if (r.pressed && InputHasAffection(i)) stroking = true;
+        }
+        if (stroking) g_affection = std::min(1.0f, g_affection.load() + 0.004f);   // stroking keeps filling up
+        g_affection = std::max(0.0f, g_affection.load() - 1.0f / 45000);          // fades over ~30 minutes
+        // longing: ask to be touched now and then (only when some input gives affection)
+        bool any_affection = false;
+        for (int i = 0; i < g_in_count; i++) any_affection |= InputHasAffection(i);
+        const float since_min = (now - g_last_touch_us.load()) / 60e6f;
+        if (any_affection && g_screen && g_affection < 0.35f && since_min > 15 && now - last_crave > 10LL * 60 * 1000000 &&
+            Application::GetInstance().GetDeviceState() == kDeviceStateIdle) {
+            last_crave = now;
+            if (g_display) g_display->ShowEyeEmotion("sad", 6);
+            g_screen->ShowNotification("ПОТРОГАЙ АНТЕННЫ...", 6000);
+        }
+    }
+}
+
+bool InitInputs() {
+    const auto inputs = Hw().inputs;
+    bool any_touch = false;
+    for (auto& in : inputs) any_touch |= in.touch;
+#if !CV_HAS_TOUCH
+    if (any_touch) ESP_LOGW(TAG, "this chip has no touch sensor: touch inputs are ignored (use buttons)");
+    any_touch = false;
+#else
+    if (any_touch) {
+        static touch_sensor_sample_config_t sample[1] = {
+            TOUCH_SENSOR_V2_DEFAULT_SAMPLE_CONFIG(500, TOUCH_VOLT_LIM_L_0V5, TOUCH_VOLT_LIM_H_2V2)};
+        touch_sensor_config_t sens_cfg = TOUCH_SENSOR_DEFAULT_BASIC_CONFIG(1, sample);
+        if (touch_sensor_new_controller(&sens_cfg, &g_touch) != ESP_OK) return false;
+    }
+    touch_channel_config_t chan_cfg = {};
+    chan_cfg.active_thresh[0] = 2000;
+    chan_cfg.charge_speed = TOUCH_CHARGE_SPEED_7;
+    chan_cfg.init_charge_volt = TOUCH_INIT_CHARGE_VOLT_DEFAULT;
+#endif
+    for (auto& in : inputs) {
+        if (g_in_count >= kMaxInputs) break;
+        auto& r = g_in[g_in_count];
+        r.pin = in.pin;
+        r.touch = in.touch;
+        if (in.touch) {
+#if CV_HAS_TOUCH
+            if (touch_sensor_new_channel(g_touch, in.pin, &chan_cfg, &r.chan) != ESP_OK) {
+                ESP_LOGE(TAG, "GPIO%d cannot be a touch input", in.pin);
+                continue;
+            }
+#else
+            continue;
+#endif
+        } else {
+            gpio_config_t io = {};
+            io.pin_bit_mask = 1ULL << in.pin;
+            io.mode = GPIO_MODE_INPUT;
+            io.pull_up_en = GPIO_PULLUP_ENABLE;
+            gpio_config(&io);
+        }
+        if (auto p = Find(in.pin)) p->mode = Mode::Antenna;
+        ESP_LOGI(TAG, "input '%s' on GPIO%d (%s)", in.name.c_str(), in.pin, in.touch ? "touch" : "button");
+        g_in_count++;
+    }
+#if CV_HAS_TOUCH
+    if (any_touch) {
+        touch_sensor_filter_config_t filter = TOUCH_SENSOR_DEFAULT_FILTER_CONFIG();
+        touch_sensor_config_filter(g_touch, &filter);
+        if (touch_sensor_enable(g_touch) != ESP_OK) return false;
+        if (touch_sensor_start_continuous_scanning(g_touch) != ESP_OK) return false;
+    }
+#endif
+    for (auto& o : Hw().outputs) {
+        gpio_config_t io = {};
+        io.pin_bit_mask = 1ULL << o.pin;
+        io.mode = GPIO_MODE_OUTPUT;
+        gpio_config(&io);
+        OutputSet(o, false);
+        if (auto p = Find(o.pin)) p->mode = Mode::Out;
+        g_outputs.push_back(o);
+    }
+    g_last_touch_us = esp_timer_get_time();
+    if (g_in_count) xTaskCreate(InputTask, "inputs", 4096, nullptr, 2, nullptr);
+    return true;
+}
+
+}  // namespace
+
+std::string AntennaStateJson() {
+    const float since = (esp_timer_get_time() - g_last_touch_us.load()) / 60e6f;
+    auto inputs = HwInputsSnapshot();
+    std::string s = "{\"inputs\":[";
+    bool touched = false;
+    for (int i = 0; i < g_in_count && i < (int)inputs.size(); i++) {
+        char buf[200];
+        snprintf(buf, sizeof(buf), "%s{\"name\":\"%s\",\"gpio\":%d,\"type\":\"%s\",\"pressed\":%s,\"raw\":%u,\"baseline\":%.0f}",
+                 i ? "," : "", inputs[i].name.c_str(), g_in[i].pin, g_in[i].touch ? "touch" : "button",
+                 g_in[i].pressed ? "true" : "false", (unsigned)g_in[i].raw.load(), g_in[i].base);
+        s += buf;
+        touched |= g_in[i].pressed;
+    }
+    char tail[160];
+    snprintf(tail, sizeof(tail), "],\"touched_now\":%s,\"touches_since_boot\":%d,\"minutes_since_last_touch\":%.1f,\"affection\":%.2f}",
+             touched ? "true" : "false", g_touches.load(), since, g_affection.load());
+    return s + tail;
+}
+
+void InitIo(Display* screen, CvEyesDisplay* eyes) {
+    g_screen = screen;
+    g_display = eyes;
+    BuildUserPins();
+    if (!InitInputs()) ESP_LOGE(TAG, "inputs init failed");
+
+    auto& mcp = McpServer::GetInstance();
+    std::string pins_hint = " Free GPIOs:";
+    for (auto& st : g_pins) {
+        if (st.mode == Mode::Free) pins_hint += " " + std::to_string(st.pin);
+    }
+    pins_hint += " (pins used by the hardware profile's inputs/outputs are excluded; GPIO2 is the power latch "
+                 "and must never be used).";
+    mcp.AddTool("self.gpio.list_pins", "List user GPIOs and what each is doing now." + pins_hint,
+        PropertyList(), [](const PropertyList&) -> ReturnValue { return ListPins(); });
+    mcp.AddTool("self.gpio.servo",
+        "Turn a hobby servo connected to a GPIO (signal wire) to `angle` degrees (0-180). "
+        "`min_us`/`max_us`: pulse width for 0 and 180 degrees (default 500/2500)." + pins_hint,
+        PropertyList({Property("pin", kPropertyTypeInteger), Property("angle", kPropertyTypeInteger, 0, 180),
+                      Property("min_us", kPropertyTypeInteger, 500, 300, 1500),
+                      Property("max_us", kPropertyTypeInteger, 2500, 1500, 3000)}),
+        [](const PropertyList& p) -> ReturnValue {
+            return Servo(p["pin"].value<int>(), p["angle"].value<int>(), p["min_us"].value<int>(), p["max_us"].value<int>());
+        });
+    mcp.AddTool("self.gpio.pwm",
+        "Output PWM on a GPIO (LED dimming, motor driver, buzzer tone). `frequency` in Hz, `duty` 0-100%." + pins_hint,
+        PropertyList({Property("pin", kPropertyTypeInteger), Property("frequency", kPropertyTypeInteger, 1000, 1, 40000),
+                      Property("duty", kPropertyTypeInteger, 0, 100)}),
+        [](const PropertyList& p) -> ReturnValue {
+            return Pwm(p["pin"].value<int>(), p["frequency"].value<int>(), p["duty"].value<int>());
+        });
+    mcp.AddTool("self.gpio.write", "Set a GPIO as digital output, `level` 0 or 1 (3.3 V)." + pins_hint,
+        PropertyList({Property("pin", kPropertyTypeInteger), Property("level", kPropertyTypeInteger, 0, 1)}),
+        [](const PropertyList& p) -> ReturnValue { return Write(p["pin"].value<int>(), p["level"].value<int>()); });
+    mcp.AddTool("self.gpio.read",
+        "Read a GPIO digital level (0/1). `pull`: none, up or down (for buttons use up)." + pins_hint,
+        PropertyList({Property("pin", kPropertyTypeInteger), Property("pull", kPropertyTypeString, std::string("none"))}),
+        [](const PropertyList& p) -> ReturnValue { return Read(p["pin"].value<int>(), p["pull"].value<std::string>()); });
+    mcp.AddTool("self.gpio.analog_read", "Read an analog voltage 0-3.1 V on a GPIO with an ADC1 channel.",
+        PropertyList({Property("pin", kPropertyTypeInteger)}),
+        [](const PropertyList& p) -> ReturnValue { return AnalogRead(p["pin"].value<int>()); });
+    mcp.AddTool("self.gpio.release", "Stop PWM/servo/output on a GPIO and leave it floating.",
+        PropertyList({Property("pin", kPropertyTypeInteger)}),
+        [](const PropertyList& p) -> ReturnValue {
+            std::lock_guard<std::mutex> lock(g_mu);
+            Release(Claim(p["pin"].value<int>()));
+            return true;
+        });
+    mcp.AddTool("self.antennae.get_state",
+        "The device's inputs (touch antennae, buttons) and its mood. It LOVES having its antennae touched: touches "
+        "raise `affection`, which slowly fades; when it is low the device feels lonely and wants to be touched.",
+        PropertyList(), [](const PropertyList&) -> ReturnValue { return AntennaStateJson(); });
+    mcp.AddTool("self.hw.reload",
+        "Download the hardware profile (display, pins, inputs and their actions, outputs, camera) from the voice "
+        "server and apply it. `url` defaults to http://<server>/device/hardware.json. Restarts if pins changed.",
+        PropertyList({Property("url", kPropertyTypeString, std::string(""))}),
+        [](const PropertyList& p) -> ReturnValue { return HwReload(p["url"].value<std::string>()); });
+    if (!g_outputs.empty()) {
+        std::string names;
+        for (auto& o : g_outputs) names += (names.empty() ? "" : ", ") + o.name + " (" + o.type + ", GPIO" + std::to_string(o.pin) + ")";
+        mcp.AddTool("self.outputs.set",
+            "Switch an output from the hardware profile on or off, or pulse it. Outputs: " + names +
+            ". `name`: output name, `state`: on, off or pulse; `ms`: pulse length.",
+            PropertyList({Property("name", kPropertyTypeString), Property("state", kPropertyTypeString),
+                          Property("ms", kPropertyTypeInteger, 300, 20, 5000)}),
+            [](const PropertyList& p) -> ReturnValue {
+                const std::string name = p["name"].value<std::string>(), st = p["state"].value<std::string>();
+                for (auto& o : g_outputs) {
+                    if (o.name != name) continue;
+                    if (st == "pulse") {
+                        OutputSet(o, true);
+                        vTaskDelay(pdMS_TO_TICKS(p["ms"].value<int>()));
+                        OutputSet(o, false);
+                    } else {
+                        OutputSet(o, st == "on");
+                    }
+                    return name + " -> " + st;
+                }
+                throw std::runtime_error("no output named " + name);
+            });
+        mcp.AddTool("self.vibrate", "Buzz the vibration motor(s) for `ms` milliseconds (e.g. to purr or alert).",
+            PropertyList({Property("ms", kPropertyTypeInteger, 300, 20, 3000)}),
+            [](const PropertyList& p) -> ReturnValue { Vibrate(p["ms"].value<int>()); return true; });
+    }
+}
+
+}  // namespace cv
