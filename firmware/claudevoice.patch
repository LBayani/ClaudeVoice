+namespace {
+struct Bus { int sda, scl; i2c_master_bus_handle_t handle; };
+Bus g_buses[SOC_I2C_NUM] = {};
+int g_bus_count = 0;
+
+#if SOC_SPI_PERIPH_NUM > 2
+constexpr spi_host_device_t kLcdHost = SPI3_HOST;
+#else
+constexpr spi_host_device_t kLcdHost = SPI2_HOST;
+#endif
+}  // namespace
+
+i2c_master_bus_handle_t I2cBus(int sda, int scl) {
+    if (sda < 0 || scl < 0) return nullptr;
+    for (int i = 0; i < g_bus_count; i++) {
+        if (g_buses[i].sda == sda && g_buses[i].scl == scl) return g_buses[i].handle;
+    }
+    if (g_bus_count >= SOC_I2C_NUM) {
+        ESP_LOGE(TAG, "no free I2C controller for SDA %d / SCL %d (this chip has %d)", sda, scl, SOC_I2C_NUM);
+        return nullptr;
+    }
+    i2c_master_bus_config_t cfg = {};
+    cfg.i2c_port = (i2c_port_t)g_bus_count;
+    cfg.sda_io_num = (gpio_num_t)sda;
+    cfg.scl_io_num = (gpio_num_t)scl;
+    cfg.clk_source = I2C_CLK_SRC_DEFAULT;
+    cfg.glitch_ignore_cnt = 7;
+    cfg.flags.enable_internal_pullup = 1;
+    i2c_master_bus_handle_t h = nullptr;
+    if (i2c_new_master_bus(&cfg, &h) != ESP_OK) {
+        ESP_LOGE(TAG, "I2C bus on SDA %d / SCL %d failed", sda, scl);
+        return nullptr;
+    }
+    g_buses[g_bus_count++] = {sda, scl, h};
+    return h;
+}
+
+static Display* CreateOled(const HwDisplay& d) {
+    auto bus = I2cBus(d.sda, d.scl);
+    if (!bus) return new NoDisplay();
+    esp_lcd_panel_io_handle_t io = nullptr;
+    esp_lcd_panel_handle_t panel = nullptr;
+    esp_lcd_panel_io_i2c_config_t io_config = {};
+    io_config.dev_addr = (uint32_t)d.i2c_addr;
+    io_config.control_phase_bytes = 1;
+    io_config.dc_bit_offset = 6;
+    io_config.lcd_cmd_bits = 8;
+    io_config.lcd_param_bits = 8;
+    io_config.scl_speed_hz = 400 * 1000;
+    if (esp_lcd_new_panel_io_i2c_v2(bus, &io_config, &io) != ESP_OK) return new NoDisplay();
+    esp_lcd_panel_dev_config_t panel_config = {};
+    panel_config.reset_gpio_num = PinOrNc(d.rst);
+    panel_config.bits_per_pixel = 1;
+    esp_lcd_panel_ssd1306_config_t ssd1306_config = {};
+    ssd1306_config.height = (uint8_t)d.height;
+    esp_err_t err;
+    if (d.driver == "sh1106") {
+        err = esp_lcd_new_panel_sh1106(io, &panel_config, &panel);
+    } else {
+        panel_config.vendor_config = &ssd1306_config;
+        err = esp_lcd_new_panel_ssd1306(io, &panel_config, &panel);
+    }
+    if (err != ESP_OK || esp_lcd_panel_reset(panel) != ESP_OK || esp_lcd_panel_init(panel) != ESP_OK) {
+        ESP_LOGE(TAG, "OLED %s init failed", d.driver.c_str());
+        return new NoDisplay();
+    }
+    esp_lcd_panel_disp_on_off(panel, true);
+    return new OledDisplay(io, panel, d.width, d.height, d.mirror_x, d.mirror_y);
+}
+
+Display* CreateDisplay(const HwDisplay& d, CvEyesDisplay** eyes) {
+    *eyes = nullptr;
+    if (d.driver == "none" || d.driver.empty()) return new NoDisplay();
+    if (d.IsOled()) return CreateOled(d);
+    if (d.mosi < 0 || d.sclk < 0) {
+        ESP_LOGE(TAG, "display %s: MOSI/SCLK pins are not set", d.driver.c_str());
+        return new NoDisplay();
+    }
+    spi_bus_config_t buscfg = {};
+    buscfg.mosi_io_num = d.mosi;
+    buscfg.miso_io_num = GPIO_NUM_NC;
+    buscfg.sclk_io_num = d.sclk;
+    buscfg.quadwp_io_num = GPIO_NUM_NC;
+    buscfg.quadhd_io_num = GPIO_NUM_NC;
+    buscfg.max_transfer_sz = d.width * d.height * sizeof(uint16_t);
+    if (spi_bus_initialize(kLcdHost, &buscfg, SPI_DMA_CH_AUTO) != ESP_OK) return new NoDisplay();
+
+    esp_lcd_panel_io_handle_t io = nullptr;
+    esp_lcd_panel_handle_t panel = nullptr;
+    esp_lcd_panel_io_spi_config_t io_config = {};
+    io_config.cs_gpio_num = PinOrNc(d.cs);
+    io_config.dc_gpio_num = PinOrNc(d.dc);
+    io_config.spi_mode = d.spi_mode;
+    io_config.pclk_hz = d.pclk_mhz * 1000 * 1000;
+    io_config.trans_queue_depth = 10;
+    io_config.lcd_cmd_bits = 8;
+    io_config.lcd_param_bits = 8;
+    if (esp_lcd_new_panel_io_spi(kLcdHost, &io_config, &io) != ESP_OK) return new NoDisplay();
+
+    esp_lcd_panel_dev_config_t panel_config = {};
+    panel_config.reset_gpio_num = PinOrNc(d.rst);
+    panel_config.rgb_ele_order = d.bgr ? LCD_RGB_ELEMENT_ORDER_BGR : LCD_RGB_ELEMENT_ORDER_RGB;
+    panel_config.bits_per_pixel = 16;
+    esp_err_t err;
+    if (d.driver == "gc9a01") err = esp_lcd_new_panel_gc9a01(io, &panel_config, &panel);
+    else if (d.driver == "ili9341") err = esp_lcd_new_panel_ili9341(io, &panel_config, &panel);
+#ifdef CV_HAS_ST7796
+    else if (d.driver == "st7796") err = esp_lcd_new_panel_st7796(io, &panel_config, &panel);
+#endif
+    else err = esp_lcd_new_panel_st7789(io, &panel_config, &panel);
+    if (err != ESP_OK) {
+        ESP_LOGE(TAG, "display driver %s failed: %s", d.driver.c_str(), esp_err_to_name(err));
+        return new NoDisplay();
+    }
+    esp_lcd_panel_reset(panel);
+    esp_lcd_panel_init(panel);
+    esp_lcd_panel_swap_xy(panel, d.swap_xy);
+    esp_lcd_panel_mirror(panel, d.mirror_x, d.mirror_y);
+    esp_lcd_panel_invert_color(panel, d.invert);
+    esp_lcd_panel_disp_on_off(panel, true);
+
+    // The animated eyes need ~250 KB of frame buffers: only with PSRAM.
+    if (heap_caps_get_total_size(MALLOC_CAP_SPIRAM) > 0) {
+        auto* e = new CvEyesDisplay(io, panel, d.width, d.height, d.offset_x, d.offset_y, d.mirror_x, d.mirror_y,
+                                    d.swap_xy);
+        e->SetupHighTempWarningPopup();
+        *eyes = e;
+        return e;
+    }
+    return new SpiLcdDisplay(io, panel, d.width, d.height, d.offset_x, d.offset_y, d.mirror_x, d.mirror_y, d.swap_xy);
+}
+
+AudioCodec* CreateAudioCodec(const HwAudio& a) {
+    if (a.codec == "i2s_simplex" && a.spk_dout >= 0 && a.mic_din >= 0) {
+        return new NoAudioCodecSimplex(a.in_rate, a.out_rate, PinOrNc(a.spk_bclk), PinOrNc(a.spk_lrck),
+                                       PinOrNc(a.spk_dout), PinOrNc(a.mic_sck), PinOrNc(a.mic_ws), PinOrNc(a.mic_din));
+    }
+    if (a.codec == "i2s_duplex" && a.bclk >= 0) {
+        return new NoAudioCodecDuplex(a.in_rate, a.out_rate, PinOrNc(a.bclk), PinOrNc(a.ws), PinOrNc(a.dout),
+                                      PinOrNc(a.din));
+    }
+    if (a.codec == "es8311" || a.codec == "box") {
+        auto bus = I2cBus(a.i2c_sda, a.i2c_scl);
+        if (bus) {
+            if (a.codec == "box") {
+                return new BoxAudioCodec(bus, a.in_rate, a.out_rate, PinOrNc(a.mclk), PinOrNc(a.bclk), PinOrNc(a.ws),
+                                         PinOrNc(a.dout), PinOrNc(a.din), PinOrNc(a.pa), (uint8_t)a.es8311_addr,
+                                         (uint8_t)a.es7210_addr, false);
+            }
+            i2c_port_t port = I2C_NUM_0;
+            for (int i = 0; i < g_bus_count; i++) if (g_buses[i].handle == bus) port = (i2c_port_t)i;
+            return new Es8311AudioCodec(bus, port, a.in_rate, a.out_rate, PinOrNc(a.mclk), PinOrNc(a.bclk),
+                                        PinOrNc(a.ws), PinOrNc(a.dout), PinOrNc(a.din), PinOrNc(a.pa),
+                                        (uint8_t)a.es8311_addr, a.use_mclk, a.pa_inverted);
+        }
+    }
+    if (a.codec != "none") ESP_LOGE(TAG, "audio codec '%s' is not fully configured: running without sound", a.codec.c_str());
+    return new DummyAudioCodec(a.in_rate, a.out_rate);
+}
+
+Camera* CreateCamera(const HwCamera& c) {
+#if CONFIG_IDF_TARGET_ESP32S3
+    if (c.type != "board") return nullptr;
+    camera_config_t config = {};
+    config.pin_d0 = c.d[0]; config.pin_d1 = c.d[1]; config.pin_d2 = c.d[2]; config.pin_d3 = c.d[3];
+    config.pin_d4 = c.d[4]; config.pin_d5 = c.d[5]; config.pin_d6 = c.d[6]; config.pin_d7 = c.d[7];
+    config.pin_xclk = c.xclk;
+    config.pin_pclk = c.pclk;
+    config.pin_vsync = c.vsync;
+    config.pin_href = c.href;
+    config.pin_sccb_sda = c.sda;
+    config.pin_sccb_scl = c.scl;
+    config.sccb_i2c_port = 1;
+    config.pin_pwdn = c.pwdn;
+    config.pin_reset = c.reset;
+    config.xclk_freq_hz = 20000000;
+    config.pixel_format = PIXFORMAT_RGB565;
+    config.frame_size = FRAMESIZE_QVGA;
+    config.jpeg_quality = 12;
+    config.fb_count = 1;
+    config.fb_location = CAMERA_FB_IN_PSRAM;
+    config.grab_mode = CAMERA_GRAB_WHEN_EMPTY;
+    ESP_LOGI(TAG, "camera module from the hardware profile");
+    return new Esp32Camera(config);
+#else
+    return nullptr;
+#endif
+}
+
+static std::string ActiveSkinUrl() {
+    Settings settings("wifi", false);
+    std::string url = settings.GetString("ota_url");
+    if (url.empty()) url = CONFIG_OTA_URL;
+    auto p = url.find("/xiaozhi/ota");
+    return (p == std::string::npos ? url : url.substr(0, p)) + "/skins/active.json";
+}
+
+static void BootTask(void* arg) {
+    auto** eyes = static_cast<CvEyesDisplay**>(arg);
+    auto& app = Application::GetInstance();
+    for (int i = 0; i < 120 && app.GetDeviceState() != kDeviceStateIdle; i++) vTaskDelay(pdMS_TO_TICKS(1000));
+    if (app.GetDeviceState() == kDeviceStateIdle) {
+        ESP_LOGI(TAG, "hardware profile: %s", HwReload("").c_str());
+        if (*eyes) ESP_LOGI(TAG, "loading skin: %s", (*eyes)->LoadSkinFromUrl(ActiveSkinUrl()).c_str());
+    }
+    vTaskDelete(nullptr);
+}
+
+void StartBootTask(CvEyesDisplay** eyes) {
+    xTaskCreate(BootTask, "cv_boot", 6144, eyes, 2, nullptr);
+}
+
+void RegisterEyeTools(CvEyesDisplay** eyes) {
+    auto& mcp = McpServer::GetInstance();
+    mcp.AddTool("self.eyes.load_skin",
+        "Download a screen skin JSON from the voice server and apply it now. `url`: skin address "
+        "(normally http://<server>/skins/active.json).",
+        PropertyList({Property("url", kPropertyTypeString)}),
+        [eyes](const PropertyList& properties) -> ReturnValue {
+            if (!*eyes) return std::string("this screen has no animated eyes");
+            return (*eyes)->LoadSkinFromUrl(properties["url"].value<std::string>());
+        });
+    mcp.AddTool("self.eyes.set_style",
+        "Switch the screen look. `style`: `classic` (retro CRT camera-lens eyes), `circuit` (circuit-board "
+        "robot face), `pixel` (8-bit game eyes), `hud` (holographic AI core), `orb` (glowing assistant orb), "
+        "`pet` (soft cute robot eyes), `minimal` (two dots and a voice line) or `eye` (one realistic eye). "
+        "Combine with self.eyes.set_color. Persists across reboots.",
+        PropertyList({Property("style", kPropertyTypeString)}),
+        [eyes](const PropertyList& properties) -> ReturnValue {
+            if (!*eyes) return std::string("this screen has no animated eyes");
+            return (*eyes)->SetEyeStyle(properties["style"].value<std::string>());
+        });
+    mcp.AddTool("self.eyes.set_color",
+        "Set the color of the robot eyes / screen phosphor. `color`: `amber` (default) or `green`. Persists across reboots.",
+        PropertyList({Property("color", kPropertyTypeString)}),
+        [eyes](const PropertyList& properties) -> ReturnValue {
+            if (!*eyes) return std::string("this screen has no animated eyes");
+            return (*eyes)->SetEyeColor(properties["color"].value<std::string>());
+        });
+    mcp.AddTool("self.eyes.show_emotion",
+        "Make the robot eyes show an emotion for a few seconds. `emotion`: neutral, happy, sad, angry, "
+        "surprised, thinking or sleepy. `seconds`: how long to hold it (1-60).",
+        PropertyList({Property("emotion", kPropertyTypeString),
+                      Property("seconds", kPropertyTypeInteger, 5, 1, 60)}),
+        [eyes](const PropertyList& properties) -> ReturnValue {
+            if (!*eyes) return std::string("this screen has no animated eyes");
+            return (*eyes)->ShowEyeEmotion(properties["emotion"].value<std::string>(),
+                                           properties["seconds"].value<int>());
+        });
+}
+
+}  // namespace cv
